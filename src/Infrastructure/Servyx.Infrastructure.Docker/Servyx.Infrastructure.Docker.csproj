<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Docker.DotNet" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Depends on Servyx.Domain directly, not Servyx.Application: Application's purpose is to
         consume ITransport/IMetricsSource/ILogStream via DI, so a reference the other way would
         create a cycle once Application actually does that. -->
    <ProjectReference Include="..\..\Core\Servyx.Domain\Servyx.Domain.csproj" />
  </ItemGroup>

</Project>
