<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Depends on Servyx.Domain directly, not Servyx.Application, for the same reason
         Servyx.Infrastructure.Docker and Servyx.Infrastructure.Ssh do: Application's purpose is to
         consume ITransport/IProvisioner via DI, so a reference the other way would create a cycle. -->
    <ProjectReference Include="..\..\Core\Servyx.Domain\Servyx.Domain.csproj" />
  </ItemGroup>

</Project>
