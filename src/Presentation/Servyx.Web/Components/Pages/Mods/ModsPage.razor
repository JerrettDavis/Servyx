@page "/mods"

<PageTitle>Mods - Servyx</PageTitle>

<div class="svx-page-header">
    <h2>Mods</h2>
    <p class="svx-page-description">Mod installation and management, per game definition.</p>
</div>

<div class="svx-empty-state">
    <h3>Mods are not supported for Palworld</h3>
