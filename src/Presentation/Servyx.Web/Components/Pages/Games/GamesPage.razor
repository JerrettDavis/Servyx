@page "/games"
@inject IDashboardDataService Data

<SvxPageTitle Section="Games" />

<div class="svx-page-header">
    <h2>Games</h2>
    <p class="svx-page-description">
        Every game definition Servyx has loaded. Import a new one below — paste or upload a
        <code>servyx.dev/v1</code> <code>GameDefinition</code> YAML document — or hand-edit
        <code>definitions/*.yaml</code> directly.
    </p>
</div>

@if (_loading)
{
    <Skeleton Variant="card" Rows="3" Label="Loading games" />
}
else if (_games.Count == 0 && _faults.Count == 0)
{
    <div class="svx-empty-state" data-testid="games-empty">
        <h3>No game definitions found</h3>
    </div>
}
else
{
    <div class="games-grid">
        @foreach (var game in _games)
        {
            <div class="svx-card game-card" data-testid="game-card">
                <div class="game-card-header">
                    <h3>@game.Name</h3>
                    <TrustBadge Trust="game.Trust" />
                </div>
                <p class="settings-value-muted">Version @game.Version</p>

                <div class="game-tags">
                    @foreach (var tag in game.Tags)
                    {
                        <span class="port-chip">@tag</span>
                    }
                </div>

                <h4 class="svx-subheading">Deployment profiles</h4>
                <ul class="deployment-profile-list">
                    @foreach (var profile in game.DeploymentProfiles)
                    {
                        <li>
                            <strong>@profile.Id</strong> <span class="settings-value-muted">(@profile.Kind)</span>
                            <p class="settings-value-muted">@profile.Description</p>
                        </li>
                    }
                </ul>

                <p class="settings-value-muted">
                    Mods: @(game.ModsSupported ? "Supported" : "Not supported for this game")
                </p>
            </div>
        }
        @foreach (var fault in _faults)
        {
            <div class="svx-card game-card game-card-fault" data-testid="game-fault-card" role="alert">
                <div class="game-card-header">
                    <h3>Definition failed to load</h3>
                    <span class="svx-badge fault-badge">Fault</span>
                </div>
                <p class="fault-path" data-testid="game-fault-path">@fault.Path</p>
                <p class="fault-message" data-testid="game-fault-message">@fault.Message</p>
                @if (fault.Line is not null)
                {
                    <p class="settings-value-muted" data-testid="game-fault-location">
                        Line @fault.Line@(fault.Column is not null ? $", column {fault.Column}" : "")
                    </p>
                }
            </div>
        }
    </div>
}

<ImportDefinitionDialog OnImported="ReloadAsync" />

@code {
    private bool _loading = true;
    private IReadOnlyList<GameCardSummary> _games = [];
    private IReadOnlyList<GameDefinitionFaultSummary> _faults = [];

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        _loading = false;
    }

    /// <summary>
    /// Re-reads both listings from <see cref="Data"/>. Called on initial load and again by
    /// <see cref="ImportDefinitionDialog"/> after a write that actually took effect, so a freshly imported
    /// definition appears in the card grid above without a manual page refresh.
    /// </summary>
    private async Task ReloadAsync()
    {
        _games = await Data.GetGamesAsync();
        _faults = await Data.GetGameDefinitionFaultsAsync();
    }
}
