@page "/"
@implements IDisposable
@inject IDashboardDataService Data
@inject PersistentComponentState ApplicationState

<PageTitle>Dashboard - Servyx</PageTitle>

<div class="svx-page-header">
    <h2>Dashboard</h2>
    <p class="svx-page-description">
        A read-only overview of every server Servyx has adopted on this Docker host.
    </p>
</div>

@if (_loading)
{
    <p>Loading dashboard…</p>
}
else if (_summary is null)
{
    <div class="svx-empty-state">
        <h3>No data available</h3>
        <p>Servyx could not load dashboard data.</p>
    </div>
}
else
{
    <div class="svx-stat-grid">
        <StatCard Title="Servers online" Value="@($"{_summary.ServersOnline} / {_summary.ServersTotal}")" Icon="servers" />
        <StatCard Title="Total players" Value="@FormatPlayers(_summary.TotalPlayers, _summary.TotalPlayerCapacity)" Icon="users" />
        <StatCard Title="Foreign backups" Value="@_summary.ForeignBackupsCount.ToString()" Icon="backups"
                   SubText="Created by each container's own tooling" />
        <StatCard Title="Alerts" Value="@_summary.AlertsCount.ToString()" Icon="audit"
                   SubText="@FormatAlertsSubText(_summary.AlertsCount)" />
    </div>

    <div class="svx-card">
        <h3>Cluster resource usage</h3>
        <div class="svx-stat-grid" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));">
            <div>
                <div class="settings-label-key">CPU (aggregate)</div>
                <Sparkline Points="@_summary.CpuSparkline" Label="CPU" Unit="%" />
            </div>
            <div>
                <div class="settings-label-key">Memory (aggregate)</div>
                <Sparkline Points="@_summary.MemorySparkline" Label="Memory" Unit="%" />
            </div>
        </div>
    </div>

    <div class="svx-card">
        <h3>Servers</h3>

        @if (_servers.Count == 0)
        {
            <div class="svx-empty-state">
                <h3>No servers adopted yet</h3>
                <p>Adopting an existing container is the first step in Milestone 1.</p>
            </div>
        }
        else
        {
            <div class="svx-row-grid" role="list" aria-label="Servers">
                <div class="svx-row-grid-header" style="grid-template-columns: 1.4fr 0.9fr 0.9fr 0.9fr 0.9fr 1fr;" aria-hidden="true">
                    <span>Name</span>
                    <span>Game</span>
                    <span>State</span>
                    <span>Health</span>
                    <span>Players</span>
                    <span>Uptime</span>
                </div>

                @foreach (var server in _servers)
                {
                    <a class="svx-row-link" role="listitem" href="@($"servers/{server.Id}")"
                       style="grid-template-columns: 1.4fr 0.9fr 0.9fr 0.9fr 0.9fr 1fr;">
                        <span><strong>@server.Name</strong></span>
                        <span>@server.Game</span>
                        <span><StateBadge State="@server.State" /></span>
                        <span><HealthBadge Health="@server.Health" Tooltip="@server.HealthTooltip" /></span>
                        <span>@FormatPlayers(server.PlayersOnline, server.PlayersMax)</span>
                        <span>@FormatUptime(server.Uptime)</span>
                    </a>
                }
            </div>
        }
    </div>
}

@code {
    private const string SummaryStateKey = "Home.Summary";
    private const string ServersStateKey = "Home.Servers";

    private bool _loading = true;
    private DashboardSummary? _summary;
    private IReadOnlyList<ServerSummary> _servers = [];
    private PersistingComponentStateSubscription _persistingSubscription;

    /// <summary>
    /// With <c>@@rendermode="InteractiveServer"</c> applied globally on <c>&lt;Routes /&gt;</c>
    /// (<c>App.razor</c>), this component runs <see cref="OnInitializedAsync"/> twice per request: once
    /// during static prerendering and again on the interactive circuit. Persisting the Docker-backed data
    /// gathered during prerender into <see cref="PersistentComponentState"/> and rehydrating it here
    /// avoids re-issuing both Docker queries a second time for the same page load.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        _persistingSubscription = ApplicationState.RegisterOnPersisting(PersistData);

        if (ApplicationState.TryTakeFromJson<DashboardSummary>(SummaryStateKey, out var restoredSummary)
            && ApplicationState.TryTakeFromJson<IReadOnlyList<ServerSummary>>(ServersStateKey, out var restoredServers))
        {
            _summary = restoredSummary;
            _servers = restoredServers ?? [];
        }
        else
        {
            _summary = await Data.GetDashboardSummaryAsync();
            _servers = await Data.GetServersAsync();
        }

        _loading = false;
    }

    private Task PersistData()
    {
        ApplicationState.PersistAsJson(SummaryStateKey, _summary);
        ApplicationState.PersistAsJson(ServersStateKey, _servers);
        return Task.CompletedTask;
    }

    public void Dispose() => _persistingSubscription.Dispose();

    private static string FormatUptime(TimeSpan? uptime)
        => uptime is null ? "—" : $"{(int)uptime.Value.TotalHours}h {uptime.Value.Minutes}m";

    /// <summary>
    /// Renders a player count pair, distinguishing "not sampled" (either value is <see langword="null"/>
    /// — the live Docker path cannot read player counts without RCON/REST, see
    /// <c>ServerSummary.PlayersOnline</c>'s remarks) from a real "0 online" measurement. Never renders
    /// "0 / 0" for data that was never actually read.
    /// </summary>
    private static string FormatPlayers(int? online, int? max)
        => online is null || max is null ? "—" : $"{online} / {max}";

    private static string FormatAlertsSubText(int alertsCount) => alertsCount switch
    {
        0 => "All clear",
        1 => "1 container reporting unhealthy",
        _ => $"{alertsCount} containers reporting unhealthy",
    };
}
