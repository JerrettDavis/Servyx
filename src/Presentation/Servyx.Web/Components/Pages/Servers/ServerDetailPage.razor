@page "/servers/{Id}"
@implements IDisposable
@using ServerBindingStatus = Servyx.Application.Servers.ServerBindingStatus
@using Servyx.Domain.Definitions.Model
@using Servyx.Domain.Lifecycle
@using Servyx.Domain.Rcon
@using Servyx.Domain.Transport
@inject IDashboardDataService Data
@inject PersistentComponentState ApplicationState
@inject IServiceProvider Services

<SvxPageTitle Section="@(_detail?.Summary.Name ?? "Server")" />

@if (_loading)
{
    <Skeleton Variant="card" Rows="2" Label="Loading server" />
}
else if (_detail is null)
{
    <div class="svx-empty-state">
        <h3>Server not found</h3>
        <p>No adopted server matches "@Id".</p>
    </div>
}
else
{
    <div class="svx-page-header">
        <h2>@_detail.Summary.Name</h2>
        <p class="svx-page-description">
            @if (_detail.Summary.BindingStatus == ServerBindingStatus.Bound)
            {
                @_detail.Summary.Game
            }
            else
            {
                <BindingStatusBadge Status="@_detail.Summary.BindingStatus" CandidateGameIds="@_detail.Summary.AmbiguousCandidateGameIds" />
            }
            · @_detail.Image
        </p>
    </div>

    @if (_detail.Summary.BindingStatus != ServerBindingStatus.Bound)
    {
        <div class="svx-card binding-status-notice binding-status-notice-@_detail.Summary.BindingStatus.ToString().ToLowerInvariant()"
             role="note" data-testid="binding-status-notice">
            @if (_detail.Summary.BindingStatus == ServerBindingStatus.Ambiguous)
            {
                <h3>Binding is ambiguous</h3>
                <p data-testid="binding-status-notice-body">
                    This server matched more than one loaded game definition with equal specificity, so
                    Servyx deliberately did not guess which one governs it — settings, lifecycle controls,
                    and the health signal are unavailable until the tie is resolved (e.g. by editing or
                    removing one of the tied definitions so only one still matches).
                </p>
                @if (_detail.Summary.AmbiguousCandidateGameIds is { Count: > 0 } candidates)
                {
                    <p>
                        Tied definitions:
                        <strong data-testid="binding-status-candidates">@string.Join(", ", candidates)</strong>
                    </p>
                }
            }
            else
            {
                <h3>Binding needs re-binding</h3>
                <p data-testid="binding-status-notice-body">
                    This server was previously bound to a game definition version (content hash) that no
                    longer resolves in the loaded catalog — most likely because the definition was edited or
                    removed. Servyx will not silently substitute a different version, so settings, lifecycle
                    controls, and the health signal are unavailable for this server. <strong>There is
                    currently no action in Servyx's UI to resolve this</strong> — re-binding requires
                    restoring or reloading a matching definition; automatically clearing or re-persisting
                    this binding is not implemented yet.
                </p>
                @if (_detail.Summary.AmbiguousCandidateGameIds is { Count: > 0 } previous)
                {
                    <p>
                        Previously bound to: <strong data-testid="binding-status-previous-id">@previous[0]</strong>
                    </p>
                }
            }
        </div>
    }

    <div class="svx-tablist" role="tablist" aria-label="Server detail sections" @onkeydown="OnTabListKeyDown">
        @foreach (var tab in Tabs)
        {
            <button type="button" class="svx-tab" role="tab" id="@($"tab-{tab}")"
                    aria-selected="@(_activeTab == tab ? "true" : "false")"
                    aria-controls="@($"panel-{tab}")"
                    tabindex="@(_activeTab == tab ? 0 : -1)"
                    @onclick="() => SelectTab(tab)">
                @tab
            </button>
        }
    </div>

    <div role="tabpanel" id="@($"panel-{_activeTab}")" aria-labelledby="@($"tab-{_activeTab}")">
        @switch (_activeTab)
        {
            case "Overview":
                <ServerOverviewTab Detail="@_detail" ServerId="@(_containerId ?? string.Empty)" WriteMode="@_writeMode" Lifecycle="@_lifecycle"
                                   StopPlan="@_stopPlan" OnWriteModeChanged="RefreshWriteModeAsync" />
                break;
            case "Console":
                <ServerConsoleTab Logs="@_logs" Commands="@_rconChannels.Catalog.Commands" WriteMode="@_writeMode" ResolveSession="@ResolveConsoleSessionAsync" />
                break;
            case "Settings":
                <ServerSettingsTab Settings="@_settings" Descriptors="@_settingDescriptorsByKey" ServerId="@(_containerId ?? string.Empty)" WriteMode="@_writeMode" />
                break;
            case "Saves":
                <ServerSavesTab Result="@_saves" />
                break;
            case "Backups":
                <ServerBackupsTab Backups="@_backups" />
                break;
        }
    </div>
}

@code {
    private static readonly string[] Tabs = ["Overview", "Console", "Settings", "Saves", "Backups"];

    [Parameter]
    public string Id { get; set; } = string.Empty;

    private bool _loading = true;
    private string _activeTab = "Overview";

    private ServerDetail? _detail;
    private IReadOnlyList<SettingRow> _settings = [];
    private IReadOnlyList<LogLine> _logs = [];
    private SavesResult _saves = new(null, SavesAvailability.NotConfigured, null);
    private IReadOnlyList<BackupEntry> _backups = [];
    private PersistingComponentStateSubscription _persistingSubscription;

    /// <summary>
    /// This server's write posture and, when one is available, its write-guarded lifecycle. Neither is
    /// persisted via <see cref="ApplicationState"/> — <see cref="IServerLifecycle"/> holds live resources
    /// (an open control-channel session) that cannot be serialized — so both are (re)computed on every
    /// pass, including the interactive one after prerendering. <see cref="ServyxServerLifecycles.GetAsync"/>
    /// memoizes per server id, so recomputing here is cheap rather than reconnecting.
    /// </summary>
    private WriteMode _writeMode = WriteMode.ReadOnly;
    private IServerLifecycle? _lifecycle;
    private StopPlan? _stopPlan;

    /// <summary>
    /// This server's real container id — the identity every per-server write grant is keyed on — resolved
    /// exactly once from the route token and then used by everything on this page that names a server.
    /// </summary>
    /// <remarks>
    /// <para>
    /// <strong>Why this field exists.</strong> <c>{Id}</c> is a route token, not an identity. Discovery
    /// resolves it against a container's id <em>or</em> its name (see
    /// <c>ServerQueryService.GetServerDetailAsync</c>), so <c>/servers/palworld-server</c> is a perfectly
    /// valid URL whose token is a display name. Passing that raw token to <see cref="WriteModeControl"/>
    /// while resolving the page's own <see cref="WriteMode"/> from the discovered summary made the two
    /// disagree: the Power card reported the grant correctly and the write-access card claimed Servyx did
    /// not track the container at all. One field, resolved once, is what keeps them agreeing by
    /// construction rather than by the route happening to carry a container hash.
    /// </para>
    /// <para>
    /// <strong>This is a resolution, not a fallback.</strong> The value is the discovered container id
    /// (<c>ServerSummary.Id</c>) returned by the same discovery/query path <c>ServyxServerLifecycles</c>
    /// resolves the write guard's own target through — <see cref="IDashboardDataService.GetServerDetailAsync"/>
    /// delegates straight to <c>IServerQueryService</c>, so this is that call's answer rather than a second,
    /// possibly-disagreeing round trip. The grant lookup itself is never widened to accept a display name:
    /// two containers may share a name, and honouring a grant against one would hand a different workload
    /// the other's write access.
    /// </para>
    /// <para>
    /// <strong>It fails closed.</strong> An unresolvable or unadopted token leaves this
    /// <see langword="null"/>, which resolves to <see cref="WriteMode.ReadOnly"/> and renders
    /// <see cref="WriteModeControl"/>'s untracked state — never an enabled control.
    /// </para>
    /// </remarks>
    private string? _containerId;

    /// <summary>
    /// Full setting-descriptor metadata (type, constraints, <c>RequiresRecreate</c>, …), keyed by
    /// <see cref="SettingDescriptor.Key"/>, for <see cref="ServerSettingsTab"/>. Sourced from the same
    /// single-definition-mode <c>IReadOnlyList&lt;SettingGroup&gt;</c> singleton the composition root
    /// registers (see <c>ServyxCoreCompositionExtensions</c>) — not persisted via <see cref="ApplicationState"/>,
    /// recomputed on every pass the same way <see cref="_lifecycle"/> and <see cref="_writeMode"/> are, since
    /// it is cheap to rebuild and carries no live resource. Empty in multi-definition mode or when no game
    /// definition loaded; <c>ServerSettingsTab</c> degrades a row with no matching descriptor to a synthetic
    /// one rather than failing to render.
    /// </summary>
    private IReadOnlyDictionary<string, SettingDescriptor> _settingDescriptorsByKey =
        new Dictionary<string, SettingDescriptor>(StringComparer.Ordinal);

    /// <summary>
    /// Resolved via <see cref="IServiceProvider"/> rather than <c>@@inject</c>, for the reason BackupsPage
    /// gives for its own optional resolutions: a host — or a bUnit test rendering this page directly —
    /// that never composed this service must still render, degrading to the safe default rather than
    /// throwing at render time over a required injection.
    /// </summary>
    private ServyxRconChannels _rconChannels = ServyxRconChannels.None;

    /// <summary>
    /// See <c>Home.razor</c>'s identical pattern for why this avoids issuing all five Docker-backed calls
    /// twice per page load across the prerender + interactive-circuit passes of
    /// <c>@@rendermode="InteractiveServer"</c>. Keys are namespaced with <see cref="Id"/> so a stale entry
    /// from a different server can never be mistakenly rehydrated.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        _persistingSubscription = ApplicationState.RegisterOnPersisting(PersistData);

        if (ApplicationState.TryTakeFromJson<ServerDetail?>(StateKey("Detail"), out var restoredDetail)
            && ApplicationState.TryTakeFromJson<IReadOnlyList<SettingRow>>(StateKey("Settings"), out var restoredSettings)
            && ApplicationState.TryTakeFromJson<IReadOnlyList<LogLine>>(StateKey("Logs"), out var restoredLogs)
            && ApplicationState.TryTakeFromJson<SavesResult>(StateKey("Saves"), out var restoredSaves)
            && ApplicationState.TryTakeFromJson<IReadOnlyList<BackupEntry>>(StateKey("Backups"), out var restoredBackups))
        {
            _detail = restoredDetail;
            _settings = restoredSettings ?? [];
            _logs = restoredLogs ?? [];
            _saves = restoredSaves ?? new(null, SavesAvailability.NotConfigured, null);
            _backups = restoredBackups ?? [];
        }
        else
        {
            _detail = await Data.GetServerDetailAsync(Id);
            _settings = await Data.GetServerSettingsAsync(Id);
            _logs = await Data.GetServerLogsAsync(Id);
            _saves = await Data.GetServerSavesWithStatusAsync(Id);
            _backups = await Data.GetServerBackupsAsync(Id);
        }

        // Resolved once, from the discovered summary, before anything on this page reads an identity.
        _containerId = string.IsNullOrWhiteSpace(_detail?.Summary.Id) ? null : _detail.Summary.Id;

        RefreshWriteMode();

        var settingGroups = Services.GetService(typeof(IReadOnlyList<SettingGroup>)) as IReadOnlyList<SettingGroup>;
        _settingDescriptorsByKey = settingGroups?.SelectMany(g => g.Items).ToDictionary(s => s.Key, StringComparer.Ordinal)
            ?? new Dictionary<string, SettingDescriptor>(StringComparer.Ordinal);

        var serverLifecycles = Services.GetService(typeof(ServyxServerLifecycles)) as ServyxServerLifecycles;
        _stopPlan = serverLifecycles?.StopPlan;
        _lifecycle = _containerId is null || serverLifecycles is null ? null : await serverLifecycles.GetAsync(_containerId);

        _rconChannels = Services.GetService(typeof(ServyxRconChannels)) as ServyxRconChannels ?? ServyxRconChannels.None;

        _loading = false;
    }

    /// <summary>
    /// Re-reads this server's posture from the live grant view. <see cref="WritableServers"/> is a view over
    /// the same per-server grants the write guard resolves through, not a startup snapshot, so calling this
    /// after a flip is what keeps every gated control on the page honest about what would actually happen.
    /// Asked with <see cref="_containerId"/> and nothing else — the display name is deliberately not offered
    /// as a second key, since names are not unique and a name-keyed grant would let one container inherit
    /// another's write access.
    /// </summary>
    private void RefreshWriteMode()
    {
        var writableServers = Services.GetService(typeof(WritableServers)) as WritableServers ?? WritableServers.None;
        _writeMode = writableServers.Mode(_containerId);
    }

    /// <summary>Invoked by <see cref="WriteModeControl"/> after a grant is applied.</summary>
    private Task RefreshWriteModeAsync()
    {
        RefreshWriteMode();
        return Task.CompletedTask;
    }

    /// <summary>Resolves this server's write-guarded RCON session for <see cref="ServerConsoleTab"/>, which surfaces a thrown <see cref="RconUnreachableException"/> itself.</summary>
    private Task<IRconSession?> ResolveConsoleSessionAsync(CancellationToken ct) =>
        _detail is null || _containerId is null
            ? Task.FromResult<IRconSession?>(null)
            : _rconChannels.GetSessionAsync(_containerId, _detail.Summary.Name, ct);

    private Task PersistData()
    {
        ApplicationState.PersistAsJson(StateKey("Detail"), _detail);
        ApplicationState.PersistAsJson(StateKey("Settings"), _settings);
        ApplicationState.PersistAsJson(StateKey("Logs"), _logs);
        ApplicationState.PersistAsJson(StateKey("Saves"), _saves);
        ApplicationState.PersistAsJson(StateKey("Backups"), _backups);
        return Task.CompletedTask;
    }

    private string StateKey(string suffix) => $"ServerDetailPage.{Id}.{suffix}";

    public void Dispose() => _persistingSubscription.Dispose();

    private void SelectTab(string tab) => _activeTab = tab;

    private void OnTabListKeyDown(KeyboardEventArgs e)
    {
        var index = Array.IndexOf(Tabs, _activeTab);
        if (index < 0)
        {
            return;
        }

        if (e.Key == "ArrowRight")
        {
            _activeTab = Tabs[(index + 1) % Tabs.Length];
        }
        else if (e.Key == "ArrowLeft")
        {
            _activeTab = Tabs[(index - 1 + Tabs.Length) % Tabs.Length];
        }
    }
}
