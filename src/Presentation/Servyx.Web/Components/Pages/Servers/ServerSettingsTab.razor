@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using Servyx.Domain.Configuration
@using Servyx.Domain.Definitions.Model
@using Servyx.Domain.Servers
@using Servyx.Domain.Transport
@using Servyx.Web.Authentication
@inject IServiceProvider Services

@if (Settings.Count == 0)
{
    <div class="svx-empty-state">
        <h3>No settings catalogue for this server</h3>
        <p>The bundled game definition did not declare any bindable settings.</p>
    </div>
}
else
{
    <p class="svx-page-description" style="margin-bottom:0.5rem;">
        Every setting shows four columns, mirroring <code>Servyx.Domain.Configuration.SettingState</code>:
        <strong>Desired</strong> (Servyx's recorded intent), <strong>Authoritative</strong> (the current
        <code>.env</code>), <strong>Rendered</strong> (the generated INI), and <strong>Runtime</strong> (the
        live server).
    </p>

    <p class="svx-page-description settings-honesty-notice" data-testid="settings-desired-not-applied-notice" style="margin-bottom:1rem;">
        Editing and saving <strong>Desired</strong> records what you want, in Servyx's own database — it does
        <strong>not</strong> change the running server. Saving records intent only. Use
        <strong>Review changes</strong> below to turn recorded values into a previewed plan you can approve;
        the Authoritative/Rendered/Runtime columns only ever change by reading the real server, never by a
        save here.
    </p>

    @if (_untracked)
    {
        <p class="svx-page-description" data-testid="settings-untracked">
            Servyx does not track this container as an adopted server, so there is nowhere to record a
            desired value. Adopt it from the servers list first.
        </p>
    }

    @if (_loadError is not null)
    {
        <p class="svx-deploy-error" data-testid="settings-load-error">@_loadError</p>
    }

    @* The per-server default for the dual-write mirroring opt-in (Server.MirrorDerivedSurfaces). Rendered here,
       above the per-row grid, because every eligible row's "inherit" option below reads this value — an
       operator needs to see and change the default in the same place the rows that fall back to it live. Only
       rendered once Servyx actually tracks this container as a server: with nothing tracked there is no Server
       row to hold a default at all, which _untracked's own notice above already explains. *@
    @if (!_untracked)
    {
        <div class="svx-card mirror-default-card" data-testid="mirror-default-card">
            <h3>Dual-write mirroring</h3>
            <p class="svx-page-description">
                When on, an eligible setting's write is also mirrored onto its derived, in-container config
                file immediately, rather than waiting for the next restart-triggered regeneration to pick it
                up. This still requires the container to be running at apply time, and only ever applies to
                settings the game definition has explicitly declared eligible — most settings show no mirror
                control at all below and are unaffected either way. A row can override this default in either
                direction with its own "Mirror to derived" control.
            </p>

            <GatedControl Enabled="@MirrorDefaultEnabled" Reason="@GatedButton.DefaultReason" Label="Mirror derived surfaces by default">
                <label class="mirror-default-toggle">
                    <input type="checkbox" class="svx-checkbox" data-testid="mirror-default-checkbox"
                           checked="@_mirrorDefault" disabled="@_mirrorDefaultBusy"
                           @onchange="e => SetMirrorDefaultAsync((bool)(e.Value ?? false))" />
                    <span>Also write eligible settings to the container's config file immediately</span>
                </label>
            </GatedControl>

            @if (_mirrorDefaultStatus is not null)
            {
                <p class="setting-save-status" data-testid="mirror-default-status">@_mirrorDefaultStatus</p>
            }
        </div>
    }

    @foreach (var group in Settings.GroupBy(s => s.Group))
    {
        <div class="settings-group">
            <h3>@group.Key</h3>

            <div class="settings-grid-header" aria-hidden="true">
                <span>Setting</span>
                <span>Desired</span>
                <span>Authoritative (.env)</span>
                <span>Rendered (INI)</span>
                <span>Runtime</span>
                <span>Drift</span>
            </div>

            @foreach (var row in group)
            {
                var descriptor = Descriptors.TryGetValue(row.Key, out var found) ? found : SyntheticDescriptor(row);
                var enabled = RowEnabled(descriptor);

                <div class="settings-row @(row.HasDrift ? "has-drift" : "")" data-testid="setting-row" data-setting-key="@row.Key">
                    <div class="settings-label" data-col-label="Setting">
                        <span>@row.Label</span>
                        <span class="settings-label-key">@row.Key</span>
                    </div>

                    <div data-col-label="Desired">
                        @if (descriptor.RequiresRecreate)
                        {
                            <p class="setting-locked-note" data-testid="setting-locked-recreate">
                                Locked: changing this setting requires the container to be recreated. Applying
                                writes the bytes to disk, but nothing in Servyx recreates a container —
                                <code>ServerLifecycleService.RecreateAsync</code> throws
                                <code>NotSupportedException</code> — so the new value would sit on disk
                                unhonored by the running container. Recording an intent Servyx cannot make
                                take effect would be misleading.
                            </p>
                        }

                        <GatedControl Enabled="@enabled" Reason="@RowReason(descriptor)" Label="@($"Desired value for {row.Label}")">
                            <div class="setting-editor-cell">
                                <SettingEditor Descriptor="@descriptor"
                                               Value="@CurrentEditValue(row, descriptor)"
                                               ValueChanged="@(v => _edits[row.Key] = v)" />

                                <GatedButton TestId="@($"setting-save-{row.Key}")"
                                             Label="@($"Save desired value for {row.Label}")"
                                             Enabled="@(enabled && !IsBusy(row.Key))"
                                             Reason="@RowReason(descriptor)"
                                             CssClass="gated-button-compact"
                                             OnClick="@(() => SaveAsync(row))">
                                    @(IsBusy(row.Key) ? "Saving…" : "Save")
                                </GatedButton>
                            </div>

                            @* Only rendered for a binding the governing definition itself declared mirror-eligible
                               (mirrorWrite: true) — most rows (ports, secrets, anything not individually opted
                               in) show nothing here at all. Three explicit options rather than a plain checkbox:
                               "inherit" is a real, distinct state from an explicit override in either direction —
                               see DesiredSettingValue.MirrorToDerived's own remarks — and a two-state control
                               cannot represent "no opinion" without a separate reset affordance. *@
                            @if (descriptor.MirroredBindings.Count > 0)
                            {
                                <div class="setting-mirror-toggle" data-testid="setting-mirror-toggle">
                                    <label>
                                        <span class="setting-mirror-toggle-label">Mirror to derived</span>
                                        @* @key forces a fresh <select> element whenever a change attempt completes, rather than
                                           letting Blazor diff against its own last-rendered "value" string. Without it, a
                                           request that ends up NOT changing MirrorSelectValue (e.g. NoDesiredValueRecorded,
                                           or a ServerNotFound refusal) leaves the browser's native <select> showing whatever
                                           the operator just clicked — Blazor sees the same "inherit" value string it rendered
                                           last time and skips re-asserting it against the DOM, so a refused change would
                                           otherwise look like it silently took effect. *@
                                        <select class="svx-select" data-testid="@($"setting-mirror-select-{row.Key}")"
                                                @key="@($"{row.Key}-{MirrorSelectVersion(row.Key)}")"
                                                disabled="@_mirrorBusy.GetValueOrDefault(row.Key)"
                                                value="@MirrorSelectValue(row.Key)"
                                                @onchange="e => SetMirrorAsync(row.Key, e.Value?.ToString())">
                                            <option value="inherit">Inherit server default (@(_mirrorDefault ? "on" : "off"))</option>
                                            <option value="on">Always mirror</option>
                                            <option value="off">Never mirror</option>
                                        </select>
                                    </label>
                                </div>

                                @if (_mirrorStatus.TryGetValue(row.Key, out var mirrorStatus))
                                {
                                    <p class="setting-save-status" data-testid="@($"setting-mirror-status-{row.Key}")">@mirrorStatus</p>
                                }
                            }

                            @if (descriptor.IsSecret && _desired.TryGetValue(row.Key, out var secretDesired))
                            {
                                <p class="setting-secret-hint" data-testid="setting-secret-hint">
                                    A desired value is already recorded (hidden) — last set by
                                    "@secretDesired.UpdatedBy" at @secretDesired.UpdatedAt.ToString("u"). Enter
                                    a new value to replace it, or leave this blank to keep it.
                                </p>
                            }

                            @if (_saveStatus.TryGetValue(row.Key, out var status))
                            {
                                <p class="setting-save-status" data-testid="setting-save-status">@status</p>
                            }
                        </GatedControl>
                    </div>

                    <div data-col-label="Authoritative (.env)" class="settings-value">@row.Authoritative</div>
                    <div data-col-label="Rendered (INI)" class="settings-value settings-value-muted">
                        <span data-testid="setting-rendered-value">@row.Rendered</span>
                        @if (ShowIniDriftWarning(row))
                        {
                            <span class="svx-badge ini-drift-warning" tabindex="0" data-testid="setting-ini-drift-warning"
                                  title="@IniDriftWarningText(EffectiveMirrors(row.Key, descriptor))">
                                ⚠ Not durable
                            </span>
                        }
                    </div>
                    <div data-col-label="Runtime" class="settings-value settings-value-muted">@row.Runtime</div>

                    <div data-col-label="Drift">
                        <DriftBadge Drift="@row.Drift" PendingRegeneration="@row.PendingRegeneration" />
                    </div>
                </div>
            }
        </div>
    }

    <ChangePlanPanel ServerId="@ServerId"
                     WriteMode="@WriteMode"
                     DesiredValues="@RecordedDesiredValues"
                     HasUnsavedEdits="@(_edits.Count > 0)"
                     UnsavedKeys="@UnsavedEditKeys" />

    @* Takes the resolved ServerId, not the container id the panel above takes: a change plan is recorded
       against the tracked server, and _resolvedServerId is null exactly when Servyx tracks no such server —
       which the history panel renders as "there is no history", not as an error. *@
    <ChangePlanHistoryPanel ServerId="@_resolvedServerId" />
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<SettingRow> Settings { get; set; } = [];

    /// <summary>
    /// Full descriptor metadata (type, constraints, <see cref="SettingDescriptor.RequiresRecreate"/>, …) for
    /// every setting whose key matches a row in <see cref="Settings"/>, keyed by
    /// <see cref="SettingDescriptor.Key"/>. Sourced from the same single-definition-mode
    /// <c>IReadOnlyList&lt;SettingGroup&gt;</c> singleton the composition root registers — see
    /// <c>ServerDetailPage</c>. Empty in multi-definition mode, in a bUnit render that supplies none, or when
    /// no game definition loaded at all; a row with no matching descriptor renders through
    /// <see cref="SyntheticDescriptor"/> rather than failing to render.
    /// </summary>
    [Parameter]
    public IReadOnlyDictionary<string, SettingDescriptor> Descriptors { get; set; } =
        new Dictionary<string, SettingDescriptor>(StringComparer.Ordinal);

    /// <summary>The server's discovery id (container id) — what <see cref="IServerSettingsService"/> resolves against.</summary>
    [Parameter]
    public string ServerId { get; set; } = string.Empty;

    /// <summary>
    /// This server's write posture. Drives whether a row's Desired field and Save button are usable — see
    /// <see cref="RowEnabled"/> for the write-gating decision and its reasoning.
    /// </summary>
    [Parameter]
    public WriteMode WriteMode { get; set; } = WriteMode.ReadOnly;

    /// <summary>
    /// The signed-in principal, when the host wired <c>CascadingAuthenticationState</c>. Optional, matching
    /// <c>WriteModeControl</c>'s own parameter — a bUnit render (or a host with authentication switched off)
    /// has none, and falls back to the same single operator identity the authentication endpoints issue.
    /// </summary>
    [CascadingParameter]
    public Task<AuthenticationState>? AuthenticationState { get; set; }

    private IServerSettingsService? _settingsService;

    /// <summary>
    /// Resolved the same way <see cref="_settingsService"/> is — optionally, through <see cref="IServiceProvider"/>
    /// — so a host or bUnit render that never composed it still renders, degrading the mirror-default control
    /// to permanently disabled rather than throwing. <see cref="IServerSettingsService"/> has no member for
    /// changing <c>Server.MirrorDerivedSurfaces</c> itself (only the per-row override), so this tab talks to
    /// <see cref="IServerRepository.SetMirrorDerivedSurfacesAsync"/> directly for that one write — the same
    /// domain-layer interface <c>GrantInvalidatingServerRepository</c> wraps everywhere else in this process,
    /// and unconditionally registered regardless of the provisioning gate (see
    /// <c>ServyxCoreCompositionExtensions</c>), matching <see cref="_settingsService"/>'s own "Servyx's own
    /// database only" write posture.
    /// </summary>
    private IServerRepository? _serverRepository;

    private Servyx.Domain.Common.ServerId? _resolvedServerId;
    private readonly Dictionary<string, DesiredSettingValue> _desired = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string?> _edits = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string?> _saveStatus = new(StringComparer.Ordinal);
    private readonly Dictionary<string, bool> _busy = new(StringComparer.Ordinal);
    private string? _loadError;
    private bool _untracked;

    // ── Dual-write mirroring ─────────────────────────────────────────────────────────────────────────
    //
    // _mirrorDefault mirrors ServerSettingsSnapshot.MirrorDerivedSurfaces, loaded off the same snapshot
    // _desired comes from — see ReloadDesiredAsync. _mirrorStatus/_mirrorBusy are per-row, keyed like
    // _saveStatus/_busy above, because a mirror-override change is independent of a value save and can be
    // in flight or reported on a different row at the same time.
    private bool _mirrorDefault;
    private bool _mirrorDefaultBusy;
    private string? _mirrorDefaultStatus;
    private readonly Dictionary<string, string> _mirrorStatus = new(StringComparer.Ordinal);
    private readonly Dictionary<string, bool> _mirrorBusy = new(StringComparer.Ordinal);

    /// <summary>
    /// Bumped every time a per-row mirror change attempt completes, and used as (part of) the mirror
    /// &lt;select&gt;'s <c>@@key</c> — see the razor markup's own remarks for why a value-string diff alone is
    /// not enough to guarantee the control reflects <see cref="MirrorSelectValue"/> after a refused change.
    /// </summary>
    private readonly Dictionary<string, int> _mirrorSelectVersion = new(StringComparer.Ordinal);

    /// <summary>
    /// Resolved through <see cref="IServiceProvider"/> rather than <c>@@inject</c>, matching
    /// <c>WriteModeControl</c>: a host — or a bUnit test rendering this tab directly — that never composed
    /// <see cref="IServerSettingsService"/> must still render, degrading to "nothing can be saved here"
    /// rather than throwing at render time over a required injection.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        _settingsService = Services.GetService(typeof(IServerSettingsService)) as IServerSettingsService;
        _serverRepository = Services.GetService(typeof(IServerRepository)) as IServerRepository;
        await ReloadDesiredAsync();
    }

    private async Task ReloadDesiredAsync()
    {
        _desired.Clear();
        _untracked = false;
        _resolvedServerId = null;
        _mirrorDefault = false;

        if (_settingsService is null || string.IsNullOrWhiteSpace(ServerId))
        {
            return;
        }

        try
        {
            var snapshot = await _settingsService.LoadAsync(ServerId);
            if (snapshot is null)
            {
                _untracked = true;
                return;
            }

            _resolvedServerId = snapshot.ServerId;
            _mirrorDefault = snapshot.MirrorDerivedSurfaces;
            foreach (var (key, value) in snapshot.Values)
            {
                _desired[key] = value;
            }
        }
        catch (Exception ex)
        {
            // Degrade visibly, matching every other backend read on this page — never a silent "nothing
            // recorded" when the truth is "could not be read".
            _loadError = $"Could not read recorded desired values: {ex.Message}";
        }
    }

    // ── Write gating ─────────────────────────────────────────────────────────────────────────────────
    //
    // Recording a desired value writes ONLY to Servyx's own database — IServerSettingsService never touches
    // IExecutionTarget, IRconSession, or any transport (see its own remarks) — so this is not the same kind
    // of act WriteGuardedExecutionTarget exists to gate, and it is deliberately NOT left unconditionally open
    // the way Phase 1's adoption is. ReadOnly is this product's promise that Servyx will not record ANY
    // operator intent for a server, not only that it will not act on one, so a ReadOnly server's fields stay
    // locked here too. PreviewOnly IS allowed to save: that tier exists precisely for computing/recording
    // what a change would be without applying it, which is exactly what "desired, not applied" already means
    // — gating it out would make PreviewOnly strictly less useful than the honesty story this phase tells.
    // RequiresRecreate settings lock regardless of WriteMode, for a narrower reason than before: IPlanExecutor
    // can now preview AND apply a plain file write for these settings just like any other. What it can never
    // do is recreate the container (ServerLifecycleService.RecreateAsync throws NotSupportedException), so an
    // applied value for one of these settings would land on disk with nothing having picked it up. Recording
    // an intent Servyx can write but never make the running workload honor would still be the dishonesty this
    // phase exists to avoid, so Enabled does not unlock them either.
    private bool RowEnabled(SettingDescriptor descriptor) =>
        WriteMode != WriteMode.ReadOnly && !descriptor.RequiresRecreate && _resolvedServerId is not null;

    private const string RequiresRecreateReason =
        "Changing this setting requires the server's container to be recreated. Applying would write the " +
        "bytes to disk, but nothing in Servyx recreates a container (ServerLifecycleService.RecreateAsync " +
        "throws NotSupportedException), so the new value would sit on disk unhonored until an operator " +
        "recreates the container by hand. Recording an intent Servyx cannot make take effect would be " +
        "misleading, so this field is locked regardless of write access.";

    private static string RowReason(SettingDescriptor descriptor) =>
        descriptor.RequiresRecreate ? RequiresRecreateReason : GatedButton.DefaultReason;

    private bool IsBusy(string key) => _busy.TryGetValue(key, out var busy) && busy;

    // ── Dual-write mirroring ─────────────────────────────────────────────────────────────────────────
    //
    // Gated the same way an ordinary desired-value save is (RowEnabled, above): mirroring preferences are
    // Servyx's own database rows, never a call to the container, so ReadOnly locks them for the same honesty
    // reason RowEnabled documents, and there is no RequiresRecreate-style extra lock — a mirror preference is
    // not itself blocked by "the container would need recreating to see it".

    private bool MirrorDefaultEnabled =>
        WriteMode != WriteMode.ReadOnly && _resolvedServerId is not null && _serverRepository is not null;

    private async Task SetMirrorDefaultAsync(bool value)
    {
        if (_serverRepository is null || _resolvedServerId is null || _mirrorDefaultBusy)
        {
            return;
        }

        _mirrorDefaultBusy = true;
        _mirrorDefaultStatus = null;

        try
        {
            var actor = await ResolveActorAsync();
            var updated = await _serverRepository.SetMirrorDerivedSurfacesAsync(
                _resolvedServerId.Value, value, actor, DateTimeOffset.UtcNow);

            if (updated is not null)
            {
                _mirrorDefault = updated.MirrorDerivedSurfaces;
                _mirrorDefaultStatus =
                    $"Server default set to {(updated.MirrorDerivedSurfaces ? "on" : "off")}, recorded against " +
                    $"\"{updated.MirrorDerivedSurfacesChangedBy}\" at {updated.MirrorDerivedSurfacesChangedAt:u}.";
            }
            else
            {
                _mirrorDefaultStatus =
                    "Nothing was changed: Servyx no longer tracks this server. It may have been forgotten in " +
                    "another session.";
            }
        }
        catch (Exception ex)
        {
            _mirrorDefaultStatus = $"Could not change the mirror default: {ex.Message}";
        }
        finally
        {
            _mirrorDefaultBusy = false;
        }
    }

    /// <summary>The value the per-row mirror &lt;select&gt; should show — the row's own override when it has one, "inherit" otherwise.</summary>
    private string MirrorSelectValue(string key) =>
        _desired.TryGetValue(key, out var desired) && desired.MirrorToDerived.HasValue
            ? (desired.MirrorToDerived.Value ? "on" : "off")
            : "inherit";

    private int MirrorSelectVersion(string key) => _mirrorSelectVersion.GetValueOrDefault(key);

    private async Task SetMirrorAsync(string key, string? selection)
    {
        if (_settingsService is null || _resolvedServerId is null || _mirrorBusy.GetValueOrDefault(key))
        {
            return;
        }

        bool? mirrorToDerived = selection switch
        {
            "on" => true,
            "off" => false,
            _ => null,
        };

        _mirrorBusy[key] = true;
        _mirrorStatus.Remove(key);

        try
        {
            var actor = await ResolveActorAsync();
            var result = await _settingsService.SetMirrorToDerivedAsync(_resolvedServerId.Value, key, mirrorToDerived, actor);

            if (result.Recorded && result.Value is not null)
            {
                _desired[key] = result.Value;
                _mirrorStatus[key] =
                    $"Mirror override set to {DescribeMirror(mirrorToDerived)}, recorded against " +
                    $"\"{result.Value.UpdatedBy}\" at {result.Value.UpdatedAt:u}.";
            }
            else if (result.Outcome == SaveDesiredValueOutcome.NoDesiredValueRecorded)
            {
                // No row to hang the override off — see SetMirrorToDerivedAsync's own remarks. Named plainly
                // rather than silently reverting the selector, so the operator knows exactly what to do next.
                _mirrorStatus[key] =
                    "Nothing was recorded: save a desired value for this setting first — there is no recorded " +
                    "row yet for a mirror override to attach to.";
            }
            else
            {
                _mirrorStatus[key] =
                    "Nothing was recorded: Servyx no longer tracks this server. It may have been forgotten in " +
                    "another session.";
            }
        }
        catch (Exception ex)
        {
            _mirrorStatus[key] = $"Could not record this preference: {ex.Message}";
        }
        finally
        {
            _mirrorBusy[key] = false;
            _mirrorSelectVersion[key] = MirrorSelectVersion(key) + 1;
        }
    }

    private static string DescribeMirror(bool? value) => value switch
    {
        true => "always mirror",
        false => "never mirror",
        _ => "inherit the server default",
    };

    /// <summary>
    /// Whether a write to <paramref name="key"/> would actually be mirrored right now, given this row's own
    /// override (if any) and the server default — used only to pick the ini-drift warning's wording below,
    /// never to gate anything: eligibility and the transport's actual mirror-writability are re-checked at
    /// plan/apply time regardless of what this returns.
    /// </summary>
    private bool EffectiveMirrors(string key, SettingDescriptor descriptor)
    {
        if (descriptor.MirroredBindings.Count == 0)
        {
            return false;
        }

        return _desired.TryGetValue(key, out var desired) ? desired.MirrorsToDerived(_mirrorDefault) : _mirrorDefault;
    }

    // ── INI-sourced-value warning ────────────────────────────────────────────────────────────────────
    //
    // Rendered (INI) is a `derivedFrom: [env]` surface that regenerates from Authoritative on the next
    // container/process restart — see definitions/palworld-docker.yaml's config.surfaces block. When it
    // currently disagrees with Authoritative, whatever the container is running with right now will be
    // discarded and replaced with the .env value the moment that regeneration next happens, whether that
    // disagreement is Servyx's own not-yet-applied change or an operator's direct edit to the INI file.
    // SettingState.PendingRegeneration already encodes exactly this — "AuthoritativeVsRendered drift on a
    // surface whose regeneration.kind is a restart" — and, deliberately, only that: a `manual` regeneration
    // trigger (ManualRegenerationRequired's territory in ChangePlanPanel) or a game with no derived surface
    // at all never sets it, so this warning only ever appears where the dual-surface risk genuinely exists.

    /// <summary>
    /// The ini-drift warning's tooltip copy. Two variants, chosen by <see cref="EffectiveMirrors"/>: a setting
    /// this codebase cannot mirror (not eligible, or eligible but not currently opted in) keeps the original
    /// "silently discarded on next restart" framing verbatim, because that framing is still fully accurate for
    /// it. A setting that IS currently opted into mirroring gets a straightforward tweak instead of the same
    /// text: for that row, Servyx itself will write this value directly into this file the next time a change
    /// is applied, so the risk is narrower — durable from the next apply onward — rather than "will be lost".
    /// The warning still fires and still says "not durable" for the drift showing right now, since mirroring
    /// a FUTURE write does not retroactively protect whatever is on disk today.
    /// </summary>
    private static string IniDriftWarningText(bool eligibleAndMirrored) => eligibleAndMirrored
        ? "This value differs from the authoritative .env value shown to the left. This setting mirrors to " +
          "the derived surface, so Servyx will write this value directly into this file the next time a " +
          "change is applied here. Until then, what is here now is still not durable: an unrelated restart " +
          "or recreate would discard it in favor of the .env value first."
        : "This value differs from the authoritative .env value shown to the left. If it was edited directly " +
          "in the container's settings file rather than through Servyx, that edit is not durable: this file " +
          "regenerates from .env on every restart, so the next restart or recreate will silently discard it in " +
          "favor of the .env value.";

    private static bool ShowIniDriftWarning(Servyx.Web.Models.SettingRow row) =>
        row.PendingRegeneration && row.Drift.HasFlag(DriftKind.AuthoritativeVsRendered);

    // ── Change plan preview ─────────────────────────────────────────────────────────────────────────
    //
    // ChangePlanPanel gets exactly the RECORDED desired values (_desired), never _edits: feeding unsaved
    // editor text into IPlanExecutor.PreviewAsync would let approved bytes reach a server that Servyx's own
    // database never recorded the intent for. _edits is surfaced separately, as the keys the panel refuses
    // to preview around, so an operator sees why rather than a preview that quietly omitted a row.

    /// <summary>Every currently recorded desired value, as the plain key/value map <see cref="IPlanExecutor.PreviewAsync"/> takes.</summary>
    private Dictionary<string, string> RecordedDesiredValues =>
        _desired.ToDictionary(kv => kv.Key, kv => kv.Value.Value, StringComparer.Ordinal);

    /// <summary>The setting keys with edited-but-unsaved text, in a stable order for display.</summary>
    private List<string> UnsavedEditKeys => _edits.Keys.OrderBy(k => k, StringComparer.Ordinal).ToList();

    /// <summary>
    /// The value to show in a row's editor. Secrets are the one case that never reads from
    /// <see cref="_desired"/> or <see cref="Servyx.Web.Models.SettingRow.Desired"/> — see
    /// <see cref="SettingEditor.Value"/>'s remarks for why a persisted secret must never round-trip into a
    /// rendered input.
    /// </summary>
    private string? CurrentEditValue(Servyx.Web.Models.SettingRow row, SettingDescriptor descriptor)
    {
        if (_edits.TryGetValue(row.Key, out var edited))
        {
            return edited;
        }

        if (descriptor.IsSecret)
        {
            return null;
        }

        return _desired.TryGetValue(row.Key, out var desired) ? desired.Value : row.Desired;
    }

    private async Task SaveAsync(Servyx.Web.Models.SettingRow row)
    {
        if (_settingsService is null || _resolvedServerId is null || IsBusy(row.Key))
        {
            return;
        }

        _busy[row.Key] = true;
        _saveStatus.Remove(row.Key);

        try
        {
            var editedValue = _edits.TryGetValue(row.Key, out var v) ? v : null;
            var actor = await ResolveActorAsync();
            var result = await _settingsService.SaveDesiredValueAsync(_resolvedServerId.Value, row.Key, editedValue, actor);

            if (result.Recorded && result.Value is not null)
            {
                _desired[row.Key] = result.Value;
                _edits.Remove(row.Key);
                _saveStatus[row.Key] =
                    $"Recorded as desired by \"{result.Value.UpdatedBy}\" at {result.Value.UpdatedAt:u}. " +
                    "Not applied to the running server.";
            }
            else
            {
                _saveStatus[row.Key] =
                    "Nothing was recorded: Servyx no longer tracks this server. It may have been forgotten " +
                    "in another session.";
            }
        }
        catch (Exception ex)
        {
            _saveStatus[row.Key] = $"Could not record this value: {ex.Message}";
        }
        finally
        {
            _busy[row.Key] = false;
        }
    }

    /// <summary>Mirrors <c>WriteModeControl.ResolveActorAsync</c> exactly — see its remarks.</summary>
    private async Task<string> ResolveActorAsync()
    {
        if (AuthenticationState is null)
        {
            return OperatorAuthentication.OperatorNameClaimValue;
        }

        var state = await AuthenticationState;
        var name = state.User.FindFirst(ClaimTypes.Name)?.Value;
        return string.IsNullOrWhiteSpace(name) ? OperatorAuthentication.OperatorNameClaimValue : name;
    }

    /// <summary>
    /// Built for a row whose key has no matching entry in <see cref="Descriptors"/> — multi-definition mode,
    /// a bUnit render that supplies none, or no game definition loaded. Degrades to the same plain
    /// text/password editing the pre-Phase-4a tab always offered (<see cref="Servyx.Web.Models.SettingRow.IsSecret"/>
    /// is the only signal available), never fails to render the row.
    /// </summary>
    private static SettingDescriptor SyntheticDescriptor(Servyx.Web.Models.SettingRow row) => new(
        Key: row.Key,
        Label: row.Label,
        Group: row.Group,
        Type: row.IsSecret ? SettingType.Secret : SettingType.String,
        Required: false,
        Default: null,
        RenderFormat: null,
        RequiresRecreate: false,
        PublishByDefault: null,
        Constraints: new SettingConstraints(null, null, null, null, null, null, null, null, null),
        Bindings: []);
}
