@using Servyx.Domain.Configuration
@using Servyx.Domain.Transport
@using Servyx.Composition
@using Servyx.Web.Services
@inject IServiceProvider Services

@* Turns Servyx's recorded desired values into a previewed IPlanExecutor.ConfigChangePlan, renders it, and —
   behind a two-step confirmation — applies it. This is the ONLY operator-reachable caller of
   IPlanExecutor.ApplyAsync in the product, which is to say the only path by which Servyx writes configuration
   to a live game server at all. Three consequences of that shape the code below:

     * The apply affordance exists only when ChangePlanPresentation.Applicability says the engine would accept
       the plan. A plan ApplyAsync would refuse gets no button — absent, not disabled — because a disabled
       "Apply" still tells an operator that approving is a thing that could work here.
     * ApplyAsync writes bytes and NOTHING else: it never restarts, never recreates. A ChangeReceipt means
       "the bytes are on disk", not "the workload picked them up", and the success copy says exactly that.
     * Failure is reported per failure mode through ChangePlanPresentation.Explain, and the plan stays on
       screen afterwards. A partially-applied plan is real and is never repaired, retried or rolled back.

   Resolves IPlanExecutor and ProvisioningGate via IServiceProvider rather than @@inject, matching
   WriteModeControl's own idiom: a host — or a bUnit test rendering this panel directly — that never composed
   IPlanExecutor must still render, degrading to "visible, locked, and explained" rather than throwing at
   render time or vanishing outright. *@

<div class="svx-card" data-testid="change-plan-panel">
    <h3>Review changes</h3>

    @if (_executor is null)
    {
        <p class="svx-page-description" data-testid="plan-executor-unavailable">
            This process did not compose a plan executor, so recorded desired values cannot be previewed or
            applied here. Recording desired values above still works; turning them into a plan does not.
        </p>
    }
    else
    {
        <p class="svx-page-description">
            Recording a desired value above only writes it to Servyx's own database. Preview turns every
            <strong>recorded</strong> desired value into a plan — with a diff, its consequences, and anything
            that would be blocked — before anything is ever written to the server.
        </p>

        @if (HasUnsavedEdits)
        {
            <p class="svx-deploy-error" data-testid="plan-unsaved-edits-block">
                Save your changes to <strong>@string.Join(", ", UnsavedKeys)</strong> before previewing —
                preview reads only recorded desired values, never unsaved editor text, so an unsaved edit
                would silently be left out of the plan.
            </p>
        }

        <GatedControl Enabled="@PreviewEnabled" Reason="@PreviewLockReason" Label="Review changes">
            <GatedButton TestId="plan-preview-button"
                         Label="Review changes"
                         Enabled="@PreviewEnabled"
                         Reason="@PreviewLockReason"
                         OnClick="PreviewAsync">
                @(_state == PanelState.Previewing ? "Previewing…" : "Review changes")
            </GatedButton>
        </GatedControl>

        @if (_error is not null)
        {
            <p class="svx-deploy-error" data-testid="plan-error">@_error</p>
        }

        @if (_plan is { } plan)
        {
            var (canApply, applyReason) = ChangePlanPresentation.Applicability(plan, WriteMode, _gate);

            @switch (plan.Feasibility)
            {
                case PlanFeasibility.FullyAchievable:
                    <p data-testid="plan-feasibility-banner" class="plan-feasibility plan-feasibility-full">
                        All @plan.Actions.Count change@(plan.Actions.Count == 1 ? "" : "s")
                        @ChangePlanPresentation.Summarize(plan.Feasibility).
                    </p>
                    break;
                case PlanFeasibility.PartiallyAchievable:
                    <p data-testid="plan-feasibility-banner" class="plan-feasibility plan-feasibility-partial">
                        @plan.Actions.Count of @(plan.Actions.Count + plan.Blocked.Count) changes can be
                        written; @ChangePlanPresentation.Summarize(plan.Feasibility).
                    </p>
                    break;
                default:
                    <p data-testid="plan-feasibility-banner" class="plan-feasibility plan-feasibility-blocked">
                        Nothing can be written; approving would do nothing.
                    </p>
                    break;
            }

            @if (plan.Feasibility != PlanFeasibility.Blocked)
            {
                <p data-testid="plan-apply-affordance" class="plan-apply-affordance @(canApply ? "can-apply" : "cannot-apply")">
                    @(canApply
                        ? "This plan can be applied. Approving writes exactly the bytes diffed below to the "
                          + "server and does nothing else — it does not restart or recreate the workload."
                        : applyReason)
                </p>
            }

            @if (plan.Consequences.Count > 0)
            {
                <div class="plan-consequences" data-testid="plan-consequences">
                    <h4>Consequences</h4>
                    <ul>
                        @foreach (var consequence in plan.Consequences)
                        {
                            <li data-testid="plan-consequence" class="plan-consequence-@consequence.Kind.ToString().ToLowerInvariant()">
                                <strong>@ChangePlanPresentation.Describe(consequence.Kind)</strong>
                                <span>@consequence.Description</span>
                            </li>
                        }
                    </ul>
                </div>
            }

            @if (plan.Actions.Count > 0)
            {
                <div class="plan-actions" data-testid="plan-actions">
                    <h4>Changes</h4>
                    @foreach (var action in plan.Actions)
                    {
                        <UnifiedDiffView Diff="@action.UnifiedDiff" Title="@action.SurfaceId" />
                    }
                </div>
            }

            @if (plan.Blocked.Count > 0)
            {
                <div class="plan-blocked" data-testid="plan-blocked">
                    <h4>Blocked</h4>
                    <ul>
                        @foreach (var blocked in plan.Blocked)
                        {
                            <li data-testid="plan-blocked-item">
                                <strong>@blocked.SettingKey</strong>
                                <p data-testid="plan-blocked-reason">@blocked.Reason</p>
                                <p data-testid="plan-blocked-remediation">@blocked.RemediationHint</p>
                            </li>
                        }
                    </ul>
                </div>
            }

            @if (plan.Diagnostics.Count > 0)
            {
                <div class="plan-diagnostics" data-testid="plan-diagnostics">
                    <h4>Diagnostics</h4>
                    <ul>
                        @foreach (var diagnostic in plan.Diagnostics)
                        {
                            <li data-testid="plan-diagnostic"
                                class="@(diagnostic.Kind == PlanDiagnosticKind.ManualRegenerationRequired ? "plan-diagnostic-warning" : "plan-diagnostic-info")">
                                @diagnostic.Message
                            </li>
                        }
                    </ul>
                </div>
            }

            <p data-testid="plan-reversibility-note" class="plan-reversibility-note">
                @(plan.IsFullyReversible
                    ? "Every action in this plan is individually reversible. Revert is not implemented; the only way back is a new plan."
                    : "Revert is not implemented; the only way back is a new plan.")
            </p>

            @* ── Approve and apply ────────────────────────────────────────────────────────────────────
               Offered only while canApply holds AND no attempt has been made yet. A plan is applicable
               exactly once — ApplyAsync refuses any plan that is no longer Previewed — so re-offering the
               control after a receipt OR after a failure would be offering an operator a second click the
               engine is guaranteed to refuse. *@
            @if (canApply && _receipt is null && _applyFailure is null)
            {
                if (!_confirmingApply)
                {
                    <button type="button" class="svx-btn svx-btn-primary"
                            data-testid="plan-apply-review"
                            aria-label="Review applying this plan"
                            @onclick="() => _confirmingApply = true">
                        Review
                    </button>
                }
                else
                {
                    <div class="svx-deploy-confirm" data-testid="plan-apply-confirm-step">
                        <p data-testid="plan-apply-confirm-body">
                            Nothing has been written yet. Confirming writes the
                            @plan.Actions.Count change@(plan.Actions.Count == 1 ? "" : "s") diffed above to
                            this server — exactly those bytes and nothing else. Servyx will not restart or
                            recreate the workload afterwards, and there is no revert: the only way back is a
                            new plan.
                            @if (plan.Feasibility == PlanFeasibility.PartiallyAchievable)
                            {
                                <text>
                                    The @plan.Blocked.Count blocked change@(plan.Blocked.Count == 1 ? "" : "s")
                                    listed above will not be performed.
                                </text>
                            }
                        </p>
                        <p data-testid="plan-apply-confirm-risk">
                            If a write lands but does not read back as the bytes you approved, Servyx stops
                            there: the write stays where it is, the remaining actions are skipped, and nothing
                            is rewritten, retried or rolled back. That state is reported here, and resolving it
                            is a human decision.
                        </p>
                        <button type="button" class="svx-btn svx-btn-danger"
                                data-testid="plan-apply-confirm" disabled="@_applying" @onclick="ApplyPlanAsync">
                            @(_applying ? "Applying…" : $"Yes, apply plan {ShortId(plan.Id)}")
                        </button>
                        <button type="button" class="svx-btn"
                                data-testid="plan-apply-cancel" disabled="@_applying" @onclick="() => _confirmingApply = false">
                            Cancel
                        </button>
                    </div>
                }
            }

            @if (_receipt is { } receipt)
            {
                <div class="svx-deploy-applied plan-apply-receipt" data-testid="plan-apply-receipt">
                    <p data-testid="plan-apply-success">
                        Applied at @receipt.AppliedAt.ToString("u"). The approved bytes are on the server. This
                        did <strong>not</strong> restart the workload.
                    </p>

                    @if (plan.RequiresRestart)
                    {
                        <p data-testid="plan-apply-restart-followup">
                            <strong>Restart required.</strong> This change does not take effect until the
                            workload starts again, and Servyx did not do that here. Use the lifecycle controls
                            on this server's <strong>Overview</strong> tab to restart it — this panel
                            deliberately does not carry a second copy of them.
                        </p>
                    }

                    @if (plan.RequiresRecreate)
                    {
                        <p data-testid="plan-apply-recreate-followup">
                            <strong>Container recreate required.</strong> Servyx cannot recreate a container —
                            <code>ServerLifecycleService.RecreateAsync</code> throws
                            <code>NotSupportedException</code> — so this value will sit on disk, unhonored by
                            the running container, until someone recreates it outside Servyx.
                        </p>
                    }

                    @if (!plan.RequiresRestart && !plan.RequiresRecreate)
                    {
                        <p data-testid="plan-apply-no-followup">
                            This plan named no restart or recreate consequence, so nothing further is required
                            for the approved bytes to be the ones on disk. Whether the workload re-reads them
                            on its own is the workload's business, not something Servyx can promise.
                        </p>
                    }
                </div>
            }

            @if (_applyFailure is { } failure)
            {
                <div class="svx-deploy-error plan-apply-failure plan-apply-failure-@failure.Kind.ToString().ToLowerInvariant()"
                     data-testid="plan-apply-failure">
                    <p data-testid="plan-apply-failure-message">@failure.Message</p>

                    @if (failure.Kind == ApplyFailureKind.Stale)
                    {
                        <button type="button" class="svx-btn"
                                data-testid="plan-apply-preview-again"
                                disabled="@(!PreviewEnabled)"
                                @onclick="PreviewAsync">
                            Preview again
                        </button>
                    }
                </div>
            }
        }
    }
</div>

@code {
    private enum PanelState
    {
        Idle,
        Previewing,
        Shown,
        Error,
    }

    /// <summary>The server's discovery id (container id) — what <see cref="IPlanExecutor.PreviewAsync"/> takes.</summary>
    [Parameter, EditorRequired]
    public string ServerId { get; set; } = string.Empty;

    /// <summary>This server's write posture. Drives whether the preview control is usable at all.</summary>
    [Parameter]
    public WriteMode WriteMode { get; set; } = WriteMode.ReadOnly;

    /// <summary>
    /// Every currently-<strong>recorded</strong> desired value for this server, keyed by setting key. Never
    /// unsaved editor state — see this component's own remarks and <see cref="HasUnsavedEdits"/>.
    /// </summary>
    [Parameter, EditorRequired]
    public IReadOnlyDictionary<string, string> DesiredValues { get; set; } =
        new Dictionary<string, string>(StringComparer.Ordinal);

    /// <summary>Whether the settings grid currently has editor text that has not been saved as a desired value.</summary>
    [Parameter]
    public bool HasUnsavedEdits { get; set; }

    /// <summary>The setting keys with unsaved edits, named in the block-preview message.</summary>
    [Parameter]
    public IReadOnlyList<string> UnsavedKeys { get; set; } = [];

    private IPlanExecutor? _executor;
    private ProvisioningGate _gate = ProvisioningGate.Closed;
    private PanelState _state = PanelState.Idle;
    private ConfigChangePlan? _plan;
    private string? _error;

    private bool _confirmingApply;
    private bool _applying;
    private ChangeReceipt? _receipt;
    private ApplyFailure? _applyFailure;

    protected override void OnInitialized()
    {
        _executor = Services.GetService(typeof(IPlanExecutor)) as IPlanExecutor;
        _gate = Services.GetService(typeof(ProvisioningGate)) as ProvisioningGate ?? ProvisioningGate.Closed;
    }

    private bool PreviewEnabled =>
        _executor is not null
        && WriteMode != WriteMode.ReadOnly
        && !HasUnsavedEdits
        && !string.IsNullOrWhiteSpace(ServerId)
        && _state != PanelState.Previewing;

    private string PreviewLockReason => WriteMode == WriteMode.ReadOnly
        ? "This server is read-only. Servyx will not record or preview operator intent for it at all."
        : HasUnsavedEdits
            ? "Save the unsaved edits above first — preview reads only recorded desired values."
            : GatedButton.DefaultReason;

    private async Task PreviewAsync()
    {
        if (!PreviewEnabled || _executor is null)
        {
            return;
        }

        _state = PanelState.Previewing;
        _error = null;
        _plan = null;

        // A new plan is a new approval. Everything the previous one produced — its receipt, its failure, and
        // any half-finished confirmation — belongs to a plan id this one is about to replace, and leaving any
        // of it on screen next to a fresh diff would attribute one plan's outcome to another.
        _receipt = null;
        _applyFailure = null;
        _confirmingApply = false;

        try
        {
            // Exactly DesiredValues, unmodified — never merged with unsaved editor state. See this
            // component's own remarks and the "preview passes exactly the recorded values" test.
            _plan = await _executor.PreviewAsync(ServerId, DesiredValues);
            _state = PanelState.Shown;
        }
        catch (Exception ex)
        {
            _error = $"Could not preview this change: {ex.Message}";
            _state = PanelState.Error;
        }
    }

    /// <summary>
    /// Applies the previewed plan — the product's only operator-reachable call to
    /// <see cref="IPlanExecutor.ApplyAsync"/>.
    /// </summary>
    /// <remarks>
    /// <para>
    /// <strong>Named <c>ApplyPlanAsync</c>, not <c>ApplyAsync</c>, on purpose.</strong>
    /// <c>WriteModeControl</c> has an unrelated local <c>ApplyAsync</c> that applies a write-mode grant, and a
    /// sibling component method with the same name reading as "the same operation" has already caused
    /// confusion once on this feature.
    /// </para>
    /// <para>
    /// <strong>Two guards, not one, and both are load-bearing.</strong> <c>_applying</c> stops a second click
    /// landing while the first call is still in flight — a real double-click beats the re-render that disables
    /// the button, so the disabled attribute alone would not be enough. The receipt/failure check stops a
    /// click after the call has returned: a plan is applicable exactly once, and <c>ApplyAsync</c> would refuse
    /// a second attempt on plan status anyway, so issuing it would only turn a completed apply's screen into
    /// an unrelated error.
    /// </para>
    /// <para>
    /// Failures are classified rather than caught by a base type: <c>PlanApplyFidelityException</c> does not
    /// derive from <see cref="InvalidOperationException"/>, and an unrecognised exception is reported as
    /// itself rather than as "something went wrong" — see <see cref="ChangePlanPresentation.Explain"/>.
    /// The plan deliberately stays on screen either way, so the diff that was approved is still readable next
    /// to the account of what happened to it.
    /// </para>
    /// </remarks>
    private async Task ApplyPlanAsync()
    {
        if (_applying || _receipt is not null || _applyFailure is not null || _executor is null || _plan is null)
        {
            return;
        }

        // Re-checked here rather than trusted from the render that drew the button: the write posture or the
        // plan could have moved between the two, and this is the last point Servyx controls before bytes go
        // to a live server.
        if (!ChangePlanPresentation.Applicability(_plan, WriteMode, _gate).CanApply)
        {
            return;
        }

        _applying = true;

        try
        {
            _receipt = await _executor.ApplyAsync(_plan.Id);
        }
        catch (Exception ex)
        {
            _applyFailure = ChangePlanPresentation.Explain(ex);
        }
        finally
        {
            _applying = false;
            _confirmingApply = false;
        }
    }

    /// <summary>
    /// The leading fragment of a plan id, for the confirmation button. Long enough to tell two plans apart in
    /// a log or a support conversation, short enough to read inside a sentence.
    /// </summary>
    private static string ShortId(string planId) => planId.Length <= 8 ? planId : planId[..8];
}
