@inject IServiceProvider Services

@* Rotation only — never bootstrap. Setting the FIRST operator password is /login's one-time flow, which
   OperatorCredentialStore.TrySetInitialPasswordAsync refuses to repeat; if this panel could set a password
   when none exists it would be a second way in that requires no credential at all. So with no password set
   this renders an explanation and no form.

   The three fields carry no `value` attribute and are keyed on _formKey: nothing typed here is ever rendered
   back into the page's markup, and clearing them after a successful rotation is done by changing the key so
   the browser builds fresh, empty inputs. *@

<div class="svx-card" data-testid="operator-password-settings-section">
    <h3>Operator password</h3>

    @if (!Section.Available)
    {
        <p class="svx-page-description" data-testid="operator-password-unavailable">
            This process did not compose an operator credential store, so the password cannot be changed here.
        </p>
    }
    else if (!Section.PasswordSet)
    {
        <p class="svx-page-description" data-testid="operator-password-not-set">
            No operator password has been set on this install yet. Setting the first one is the sign-in page's
            one-time first-run flow; it deliberately cannot be done from here, because a form that sets a
            password without needing the current one would be a way in that requires no credential.
        </p>
    }
    else
    {
        <p class="svx-page-description">
            Servyx has one shared operator password. Changing it here replaces the stored verifier
            immediately; anyone using the old password — including on a browser that is already signed in the
            next time its session is re-established — will need the new one.
        </p>

        @if (!Section.AuthenticationEnabled)
        {
            <p class="svx-deploy-error" data-testid="operator-password-gate-open">
                Authentication is switched off in this process (<code>@Section.AuthenticationConfigurationKey</code>
                is <code>false</code>), so anyone who can reach this port is already an administrator and no
                password is being asked for. Changing it here still works, but it protects nothing until that
                key is set back to <code>true</code> on the host and Servyx is restarted.
            </p>
        }

        <label>
            <span>Current password</span>
            <input class="svx-input" type="password" data-testid="current-password-input"
                   @key="@($"current-{_formKey}")" autocomplete="current-password"
                   disabled="@_busy" @onchange="e => _current = e.Value?.ToString() ?? string.Empty" />
        </label>

        <label>
            <span>New password (at least @Section.MinimumPasswordLength characters)</span>
            <input class="svx-input" type="password" data-testid="new-password-input"
                   @key="@($"new-{_formKey}")" autocomplete="new-password"
                   disabled="@_busy" @onchange="e => _new = e.Value?.ToString() ?? string.Empty" />
        </label>

        <label>
            <span>Confirm new password</span>
            <input class="svx-input" type="password" data-testid="confirm-password-input"
                   @key="@($"confirm-{_formKey}")" autocomplete="new-password"
                   disabled="@_busy" @onchange="e => _confirm = e.Value?.ToString() ?? string.Empty" />
        </label>

        <button type="button" class="svx-btn svx-btn-primary" data-testid="change-password-button"
                disabled="@_busy" @onclick="ChangeAsync">
            @(_busy ? "Changing…" : "Change password")
        </button>

        @if (_error is not null)
        {
            <p class="svx-deploy-error" data-testid="operator-password-error">@_error</p>
        }

        @if (_applied is not null)
        {
            <p class="svx-deploy-applied" data-testid="operator-password-applied">@_applied</p>
        }
    }
</div>

@code {
    /// <summary>The credential facts to render. Supplied by the page, which read every section in one call.</summary>
    [Parameter, EditorRequired]
    public OperatorCredentialSettingsSection Section { get; set; } =
        OperatorCredentialSettingsSection.Unavailable(true, string.Empty);

    /// <summary>Raised after a successful rotation, so the page can re-read every section.</summary>
    [Parameter]
    public EventCallback OnChanged { get; set; }

    private ISettingsDataService? _service;

    private string _current = string.Empty;
    private string _new = string.Empty;
    private string _confirm = string.Empty;

    /// <summary>Bumped after a successful rotation to rebuild the three inputs empty. See the comment above.</summary>
    private Guid _formKey = Guid.NewGuid();

    private bool _busy;
    private string? _error;
    private string? _applied;

    protected override void OnInitialized() =>
        _service = Services.GetService(typeof(ISettingsDataService)) as ISettingsDataService;

    private async Task ChangeAsync()
    {
        if (_busy || _service is null)
        {
            return;
        }

        _error = null;
        _applied = null;

        // Checked here rather than in the service: a mismatched confirmation is a typo in this form, not a
        // fact about the credential store, and there is nothing to ask it.
        if (!string.Equals(_new, _confirm, StringComparison.Ordinal))
        {
            _error = "The new password and its confirmation do not match. Nothing was changed.";
            return;
        }

        _busy = true;

        try
        {
            var result = await _service.ChangeOperatorPasswordAsync(_current, _new);

            _applied = result.Outcome is OperatorPasswordChangeOutcome.Changed
                ? "The operator password has been changed. The next sign-in needs the new one."
                : null;

            _error = result.Outcome switch
            {
                OperatorPasswordChangeOutcome.CurrentPasswordIncorrect =>
                    "The current password is not correct. Nothing was changed.",
                OperatorPasswordChangeOutcome.NewPasswordRejected =>
                    $"The new password was refused and nothing was changed: {result.Detail}",
                OperatorPasswordChangeOutcome.Unavailable =>
                    "This process did not compose an operator credential store, so nothing was changed.",
                OperatorPasswordChangeOutcome.Failed =>
                    "The password could not be changed. The existing password is unchanged; see the server "
                    + "log for what failed.",
                _ => null,
            };

            if (result.Outcome is OperatorPasswordChangeOutcome.Changed)
            {
                Reset();

                if (OnChanged.HasDelegate)
                {
                    await OnChanged.InvokeAsync();
                }
            }
        }
        catch (Exception ex)
        {
            // Two plaintext passwords are in scope on this path, so the exception's own message is not
            // rendered — only that something failed. The service logs the detail.
            _error = $"Could not change the password: {ex.GetType().Name}. Nothing was changed.";
        }
        finally
        {
            _busy = false;
        }
    }

    private void Reset()
    {
        _current = string.Empty;
        _new = string.Empty;
        _confirm = string.Empty;
        _formKey = Guid.NewGuid();
    }
}
