@page "/settings"

<SvxPageTitle Section="Settings" />

<div class="svx-page-header">
    <h2>Settings</h2>
    <p class="svx-page-description">Application-wide Servyx configuration, distinct from any single server's settings.</p>
</div>

<div class="svx-empty-state">
    <h3>Nothing to configure yet</h3>
    <p>
        Identity, RBAC, secrets, and the audit UI arrive in Milestone 7 — that is also when application-level
        settings such as host connections and persistence become configurable from here.
    </p>
</div>
