@using Servyx.Web.Models
@* Docker container health, rendered as a badge that is always visually and semantically separate from
   the server's lifecycle state badge — see docs/architecture.md, "Readiness vs. Container Health". *@

<span class="badge health-badge health-@Health.ToString().ToLowerInvariant()" title="@Tooltip" tabindex="0">
    <span class="health-dot" aria-hidden="true"></span>
    @Health
</span>

@code {
    [Parameter, EditorRequired]
    public ContainerHealth Health { get; set; }

    [Parameter]
    public string? Tooltip { get; set; }
}
