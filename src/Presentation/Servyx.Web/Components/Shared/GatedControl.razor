@* Wraps arbitrary form content (inputs, selects, groups of both) in a native <fieldset disabled>,
   which disables every nested control per standard HTML semantics, plus a lock icon and tooltip.
   Use this for settings-form fields; use <GatedButton> for standalone action buttons.
   <see cref="Enabled"/> defaults to false, so a call site that has not been taught a write posture keeps
   rendering byte-identically to before: permanently disabled, lock icon shown. *@

<fieldset class="gated-control @CssClass" disabled="@(!Enabled)" title="@(Enabled ? null : Reason)" aria-label="@AriaLabel" data-testid="gated-control">
    @if (!Enabled)
    {
        <span class="gated-control-lock" aria-hidden="true"><Icon Name="lock" Size="13" /></span>
    }
    @ChildContent
</fieldset>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string Reason { get; set; } = GatedButton.DefaultReason;

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public string CssClass { get; set; } = string.Empty;

    /// <summary>Whether the wrapped controls are actually enabled. Defaults to <see langword="false"/> — see <see cref="GatedButton.Enabled"/>'s remarks.</summary>
    [Parameter]
    public bool Enabled { get; set; }

    private string? AriaLabel => Enabled
        ? Label
        : (string.IsNullOrWhiteSpace(Label) ? Reason : $"{Label}. {Reason}");
}
