@* Small, self-contained icon set. Purely decorative: always aria-hidden, the adjacent text carries the label. *@
<svg class="svx-icon" viewBox="0 0 24 24" width="@Size" height="@Size" fill="none" stroke="currentColor"
     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "dashboard":
            <rect x="3" y="3" width="7" height="9" rx="1.2" />
            <rect x="14" y="3" width="7" height="5" rx="1.2" />
            <rect x="14" y="12" width="7" height="9" rx="1.2" />
            <rect x="3" y="16" width="7" height="5" rx="1.2" />
            break;
        case "servers":
            <rect x="3" y="4" width="18" height="6" rx="1.2" />
            <rect x="3" y="14" width="18" height="6" rx="1.2" />
            <circle cx="7" cy="7" r="0.6" fill="currentColor" />
            <circle cx="7" cy="17" r="0.6" fill="currentColor" />
            break;
        case "games":
            <rect x="2.5" y="7" width="19" height="11" rx="4" />
            <line x1="7" y1="10.5" x2="7" y2="14.5" />
            <line x1="5" y1="12.5" x2="9" y2="12.5" />
            <circle cx="16" cy="11" r="0.9" fill="currentColor" />
            <circle cx="18.2" cy="13.5" r="0.9" fill="currentColor" />
            break;
        case "backups":
            <rect x="3" y="3" width="18" height="5" rx="1.2" />
            <path d="M4.5 8v9a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V8" />
            <line x1="10" y1="12" x2="14" y2="12" />
            break;
        case "mods":
            <path d="M9 3.5h3v2.6a1.6 1.6 0 0 0 3.1.4V3.5H18v3.9a1.6 1.6 0 0 0 .4 3.1H21v3H18.4a1.6 1.6 0 0 0-1.1 2.7l1.6 1.6-2.1 2.1-1.6-1.6a1.6 1.6 0 0 0-2.7 1.1V21H9v-2.6a1.6 1.6 0 0 0-2.7-1.1l-1.6 1.6-2.1-2.1 1.6-1.6a1.6 1.6 0 0 0-1.1-2.7H0.5v-3H3.1a1.6 1.6 0 0 0 1.1-2.7L2.6 5.2l2.1-2.1 1.6 1.6A1.6 1.6 0 0 0 9 3.5Z" />
            break;
        case "plugins":
            <path d="M9 2v4M15 2v4" />
            <path d="M6 8h12v4a6 6 0 0 1-12 0V8Z" />
            <path d="M12 18v4" />
            break;
        case "settings":
            <circle cx="12" cy="12" r="3.2" />
            <path d="M19.4 13.8a7.6 7.6 0 0 0 0-3.6l2-1.4-2-3.4-2.3.9a7.6 7.6 0 0 0-3.1-1.8L13.6 2h-3.2l-.4 2.5a7.6 7.6 0 0 0-3.1 1.8l-2.3-.9-2 3.4 2 1.4a7.6 7.6 0 0 0 0 3.6l-2 1.4 2 3.4 2.3-.9a7.6 7.6 0 0 0 3.1 1.8l.4 2.5h3.2l.4-2.5a7.6 7.6 0 0 0 3.1-1.8l2.3.9 2-3.4-2-1.4Z" />
            break;
        case "users":
            <circle cx="9" cy="8" r="3.2" />
            <path d="M2.8 20a6.2 6.2 0 0 1 12.4 0" />
            <path d="M16.5 5.2a3.2 3.2 0 0 1 0 6.2" />
            <path d="M15.3 14.2a6.2 6.2 0 0 1 5.9 5.8" />
            break;
        case "audit":
            <rect x="5" y="3" width="14" height="18" rx="1.5" />
            <path d="M9 2.5h6v3H9z" />
            <line x1="8" y1="11" x2="16" y2="11" />
            <line x1="8" y1="15" x2="16" y2="15" />
            <line x1="8" y1="7.5" x2="12" y2="7.5" />
            break;
        case "lock":
            <rect x="5" y="10.5" width="14" height="9.5" rx="1.6" />
            <path d="M8 10.5V7a4 4 0 0 1 8 0v3.5" />
            break;
        case "power":
            <path d="M12 3v8" />
            <path d="M6.2 6.2a8 8 0 1 0 11.6 0" />
            break;
        case "chevron":
            <polyline points="8,5 15,12 8,19" />
            break;
        case "menu":
            <line x1="4" y1="6" x2="20" y2="6" />
            <line x1="4" y1="12" x2="20" y2="12" />
            <line x1="4" y1="18" x2="20" y2="18" />
            break;
        default:
            <circle cx="12" cy="12" r="8" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public int Size { get; set; } = 18;
}
