@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject IDashboardDataService Data
@inject IServiceProvider Services

<div class="svx-shell">
    <input type="checkbox" id="svx-sidebar-toggle" class="svx-sidebar-toggle-input" />

    <aside class="svx-sidebar">
        <NavMenu />
    </aside>

    <label for="svx-sidebar-toggle" class="svx-sidebar-scrim" aria-hidden="true"></label>

    <div class="svx-main">
        <header class="svx-topbar">
            <label for="svx-sidebar-toggle" class="svx-menu-toggle" aria-label="Toggle navigation menu">
                <Icon Name="menu" Size="20" />
            </label>

            <h1 class="svx-page-title">@_pageTitle</h1>

            <div class="svx-topbar-right">
                <ThemeToggle />
                <span class="svx-topbar-divider"></span>

                @if (_writableServers.Any)
                {
                    <span class="svx-writable-badge" tabindex="0" title="@_writableTooltip">
                        <Icon Name="power" Size="14" />
                        WRITES ENABLED
                    </span>
                }
                else
                {
                    <span class="svx-readonly-badge" tabindex="0"
                          title="No server currently has write access granted. Every server stays read-only until an operator explicitly enables writes for it — see the Enabling writes guide.">
                        <Icon Name="lock" Size="14" />
                        READ-ONLY MODE
                    </span>
                }

                <span class="svx-connection svx-connection-@_connectionCss" tabindex="0" title="@_connectionTooltip">
                    <span class="svx-connection-dot" aria-hidden="true"></span>
                    Docker host: @_connectionLabel
                </span>

                @if (_authenticationEnabled)
                {
                    @* An ordinary HTML form, not an EditForm: sign-out has to reach the server's cookie
                       handler through a real request, which an interactive component's event handler cannot
                       do. It carries no antiforgery token because it does not need one — the auth cookie is
                       SameSite=Strict, so a cross-site POST never carries it and therefore never signs
                       anyone out. *@
                    <form method="post" action="logout" class="svx-signout-form">
                        <button type="submit" class="svx-signout" data-testid="sign-out">Sign out</button>
                    </form>
                }
            </div>
        </header>

        <main class="svx-content">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string _pageTitle = "Servyx";
    private ConnectionStatus _status = ConnectionStatus.Connected;
    private string _transportId = "docker";
    private string? _connectionDetail;

    /// <summary>
    /// Whether this process requires a login, and therefore whether there is a session to end. Resolved
    /// through <see cref="IServiceProvider"/> so a host that never registered the gate still renders — and,
    /// unlike the provisioning lookup in <c>NavMenu</c>, defaults to enforced when absent.
    /// </summary>
    private bool _authenticationEnabled = true;

    /// <summary>
    /// The servers this process currently holds a write grant for. Resolved through
    /// <see cref="IServiceProvider"/> for the same reason <see cref="_authenticationEnabled"/> is: a host
    /// that never registered it still renders, and — mirroring <see cref="WritableServers.None"/> being the
    /// safe state for a closed <see cref="ProvisioningGate"/> — defaults to "nothing is writable" when
    /// absent, never the reverse.
    /// </summary>
    private WritableServers _writableServers = WritableServers.None;

    /// <summary>
    /// The writable badge's tooltip. Deliberately reports only a count, not which servers — the grant set
    /// can change per deploy and this badge is not the place an operator audits it (see the Enabling writes
    /// guide for the full per-server picture); a stale or partial name list would be worse than a count.
    /// </summary>
    private string _writableTooltip => _writableServers.Keys.Count == 1
        ? "Write access is enabled for 1 server. Every other server remains read-only until an operator grants it."
        : $"Write access is enabled for {_writableServers.Keys.Count} servers. Every other server remains read-only until an operator grants it.";

    private string _connectionCss => _status switch
    {
        ConnectionStatus.Connected => "connected",
        ConnectionStatus.Degraded => "degraded",
        _ => "disconnected",
    };

    private string _connectionLabel => _status switch
    {
        ConnectionStatus.Connected => "Connected",
        ConnectionStatus.Degraded => "Degraded",
        _ => "Disconnected",
    };

    /// <summary>
    /// The connection tooltip's text. Prefers the real, transport-reported <see cref="_connectionDetail"/>
    /// (e.g. "Docker 27.3.1 (API 1.47) on linux/amd64..." for local Docker, or "docker CLI found but could
    /// not be invoked — permission denied (exit 126): the SSH user is likely not a member of the \"docker\"
    /// group." for ssh+docker) over a generic, per-status fallback — never a hardcoded claim about a
    /// specific transport that may not be the one actually in play. See
    /// <c>SshDockerTransport.ProbeAsync</c> and <c>DockerTransport.ProbeAsync</c> for where this text is
    /// computed.
    /// </summary>
    private string _connectionTooltip => !string.IsNullOrWhiteSpace(_connectionDetail)
        ? _connectionDetail
        : _fallbackConnectionTooltip;

    private string _fallbackConnectionTooltip => _status switch
    {
        ConnectionStatus.Connected => $"Reachable over the {_transportId} transport.",
        ConnectionStatus.Degraded => "The Docker host is reachable but responding slowly or with partial data.",
        _ => "The Docker host is not reachable. Server data shown may be stale.",
    };

    protected override async Task OnInitializedAsync()
    {
        _authenticationEnabled =
            (Services.GetService(typeof(AuthenticationGate)) as AuthenticationGate
                ?? AuthenticationGate.Enforced).Enabled;

        _writableServers = Services.GetService(typeof(WritableServers)) as WritableServers
            ?? WritableServers.None;

        var connection = await Data.GetDockerConnectionInfoAsync();
        _status = connection.Status;
        _transportId = connection.TransportId;
        _connectionDetail = connection.Detail;
        UpdateTitle();
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdateTitle();
        InvokeAsync(StateHasChanged);
    }

    private void UpdateTitle()
    {
        var relative = Nav.ToBaseRelativePath(Nav.Uri);
        _pageTitle = NavCatalog.TitleFor(relative);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
