@implements IDisposable
@inject NavigationManager Nav

<div class="svx-brand">
    <span class="svx-brand-mark" aria-hidden="true">S</span>
    <span class="svx-brand-word">Servyx</span>
</div>

<nav class="svx-nav" aria-label="Primary">
    <ul class="svx-nav-list">
        @foreach (var entry in NavCatalog.Entries)
        {
            var href = entry.Href;
            var isActive = IsActive(href);
            <li class="svx-nav-item">
                <NavLink href="@href" Match="@(href == "" ? NavLinkMatch.All : NavLinkMatch.Prefix)"
                         class="svx-nav-link" ActiveClass="svx-nav-link-active"
                         aria-current="@(isActive ? "page" : null)" title="@entry.Label">
                    <Icon Name="@entry.Icon" Size="18" />
                    <span class="svx-nav-label">@entry.Label</span>
                </NavLink>
            </li>
        }
    </ul>
</nav>

@code {
    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => InvokeAsync(StateHasChanged);

    private bool IsActive(string href)
    {
        var relative = Nav.ToBaseRelativePath(Nav.Uri).TrimEnd('/');
        return href == "" ? relative.Length == 0 : relative.Equals(href, StringComparison.OrdinalIgnoreCase)
            || relative.StartsWith(href + "/", StringComparison.OrdinalIgnoreCase);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
