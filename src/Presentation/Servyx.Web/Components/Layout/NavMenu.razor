@implements IDisposable
@inject NavigationManager Nav
@inject IServiceProvider Services

<div class="svx-brand">
    <span class="svx-brand-mark" aria-hidden="true">S</span>
    <span class="svx-brand-word">Servyx</span>
</div>

<nav class="svx-nav" aria-label="Primary">
    <ul class="svx-nav-list">
        @foreach (var entry in NavCatalog.EntriesFor(_provisioningEnabled))
        {
            var href = entry.Href;
            var isActive = IsActive(href);
            <li class="svx-nav-item">
                <NavLink href="@href" Match="@(href == "" ? NavLinkMatch.All : NavLinkMatch.Prefix)"
                         class="svx-nav-link" ActiveClass="svx-nav-link-active"
                         aria-current="@(isActive ? "page" : null)" title="@entry.Label">
                    <Icon Name="@entry.Icon" Size="18" />
                    <span class="svx-nav-label">@entry.Label</span>
                </NavLink>
            </li>
        }
    </ul>
</nav>

@code {
    private bool _provisioningEnabled;

    /// <summary>
    /// The gate is resolved through <see cref="IServiceProvider"/> rather than <c>@@inject</c>d, because a
    /// host that never wired provisioning must not be required to register anything for the sidebar to
    /// render — and because "the gate is not registered" and "the gate is closed" must produce the same
    /// nine-entry sidebar. Required injection would turn the first case into a render-time exception.
    /// </summary>
    protected override void OnInitialized()
    {
        _provisioningEnabled = (Services.GetService(typeof(ProvisioningGate)) as ProvisioningGate ?? ProvisioningGate.Closed).Enabled;

        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => InvokeAsync(StateHasChanged);

    private bool IsActive(string href)
    {
        var relative = Nav.ToBaseRelativePath(Nav.Uri).TrimEnd('/');
        return href == "" ? relative.Length == 0 : relative.Equals(href, StringComparison.OrdinalIgnoreCase)
            || relative.StartsWith(href + "/", StringComparison.OrdinalIgnoreCase);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
