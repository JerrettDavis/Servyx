<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <!-- Servyx.Web now wires the dashboard to real data: it consumes Servyx.Application's use-case
         layer and registers Servyx.Infrastructure.Docker's implementations behind it. Servyx.Domain is
         still referenced directly for the shared enums (ServerState) that both mock and live view
         models are built on. -->
    <ProjectReference Include="..\..\Core\Servyx.Domain\Servyx.Domain.csproj" />
    <ProjectReference Include="..\..\Core\Servyx.Application\Servyx.Application.csproj" />
    <!-- Servyx.Infrastructure supplies the Data Protection-backed ISecretStore. The operator password's
         PBKDF2 verifier is a secret like any other, so it is written through the same store, at the same
         kind of secret:// URN, rather than through a storage mechanism invented for authentication. -->
    <ProjectReference Include="..\..\Infrastructure\Servyx.Infrastructure\Servyx.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Servyx.Infrastructure.Docker\Servyx.Infrastructure.Docker.csproj" />
    <!-- Servyx.Infrastructure.Rcon supplies the Source RCON protocol client and the write-guarded session
         decorator. The composition root is the only layer that can turn a server id into an endpoint, a
         credential URN and a definition-parsed command catalogue, which is why the wiring lives here (see
         ServyxRconChannels) rather than in the protocol assembly. -->
    <ProjectReference Include="..\..\Infrastructure\Servyx.Infrastructure.Rcon\Servyx.Infrastructure.Rcon.csproj" />
    <!-- Servyx.Infrastructure.Ssh supplies the SSH transport and SshBackupProvider. Only the *backup* half
         is composed here (AddServyxSshBackups) and only behind Servyx:Provisioning:Enabled — see the SSH
         block in Program.cs. AddServyxSsh() is deliberately NOT called: it registers a second ITransport,
         which would make the single-ITransport injection in ServyxBackupContextSource resolve to SSH and
         silently point Docker backups at the wrong machine. -->
    <ProjectReference Include="..\..\Infrastructure\Servyx.Infrastructure.Ssh\Servyx.Infrastructure.Ssh.csproj" />
    <!-- The remaining provisioning adapters, so /deploy can offer more than one target. Every one of them is
         individually opt-in behind Servyx:Provisioners:<name>:Enabled on top of Servyx:Provisioning:Enabled,
         and a host that configures none composes none — see ProvisionerWiringOptions and
         ProvisionerComposition. Referencing an assembly is not registering anything from it.

         Note what is deliberately NOT taken from these four: none of AddServyxLocalProcess(),
         AddServyxSshProvisioning() or AddServyxProcessProvisioning() is called, because each needs a second
         ITransport in the container and ITransport is injected singly by ServyxBackupContextSource. And the
         three cloud projects carry no PackageReference at all — not even DependencyInjection.Abstractions —
         which is what lets them hold no logger and so have no path that could log an API token; they are
         factory-composed at the root rather than given a registration extension, and must stay that way. -->
    <ProjectReference Include="..\..\Infrastructure\Servyx.Infrastructure.Process\Servyx.Infrastructure.Process.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Servyx.Infrastructure.DigitalOcean\Servyx.Infrastructure.DigitalOcean.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Servyx.Infrastructure.Azure\Servyx.Infrastructure.Azure.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Servyx.Infrastructure.Aws\Servyx.Infrastructure.Aws.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Servyx.Infrastructure.Persistence\Servyx.Infrastructure.Persistence.csproj" />
    <ProjectReference Include="..\..\Hosting\Servyx.ServiceDefaults\Servyx.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled game definition, copied to the output directory so it can be loaded at runtime without
         reaching outside the published app's own directory tree. -->
    <None Include="..\..\..\definitions\palworld-docker.yaml" Link="definitions\palworld-docker.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
