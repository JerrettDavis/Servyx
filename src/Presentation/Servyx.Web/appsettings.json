{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Servyx": {
    "DataSource": "Live",
    "Hosts": {
      "example-remote": {
        "Enabled": false,
        "Transport": "ssh+docker",
        "Endpoint": "ssh:user@example.invalid:22",
        "CredentialUrn": "secret://host/example-remote/ssh/private-key",
        "TrustPolicy": "requirePinned",
        "PinnedFingerprints": "SHA256:REPLACE_ME",
        "Container": "example-container"
      }
    },
    "Servers": {
      "example-remote-server": {
        "Ssh": {
          "Enabled": false,
          "Host": "user@example.invalid:22",
          "Root": "/opt/example/data",
          "ForeignDirectory": "backups",
          "ForeignPattern": "*.tar.gz"
        }
      }
    }
  }
}
