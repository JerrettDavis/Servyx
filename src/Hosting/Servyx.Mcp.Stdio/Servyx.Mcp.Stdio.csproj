<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Presentation\Servyx.Mcp\Servyx.Mcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- A None item's CopyToOutputDirectory does NOT flow across a ProjectReference, so this glob is
         duplicated from Servyx.Web.csproj rather than relied upon transitively — without it this host
         ships with zero definitions, adopts nothing, and honestly reports "no definitions loaded",
         which looks like correct behaviour rather than a packaging bug. -->
    <None Include="..\..\..\definitions\*.yaml" Link="definitions\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
