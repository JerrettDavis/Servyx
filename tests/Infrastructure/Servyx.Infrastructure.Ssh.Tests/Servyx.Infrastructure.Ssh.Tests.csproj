<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <VSTestTestCaseFilter Condition="'$(VSTestTestCaseFilter)' == ''">Category!=Integration</VSTestTestCaseFilter>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="TinyBDD" />
    <PackageReference Include="TinyBDD.Xunit" />
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="Xunit.SkippableFact" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Infrastructure\Servyx.Infrastructure.Ssh\Servyx.Infrastructure.Ssh.csproj" />
    <!-- Read-only use of FileHostKeyStore (a real IHostKeyStore) in integration tests, for genuine
         pinning behavior rather than a hand-rolled fake. Servyx.Infrastructure itself is not modified. -->
    <ProjectReference Include="..\..\..\src\Infrastructure\Servyx.Infrastructure\Servyx.Infrastructure.csproj" />
    <!-- The two provisioning adapters must stamp an identical Servyx tag vocabulary onto the resources they
         create, or each one's orphan sweep goes blind to the other's resources with nothing raised anywhere.
         Neither *source* project may reference the other (infrastructure references Servyx.Domain only), so
         the only place that invariant can actually be asserted is a test assembly that sees both. This
         reference exists for exactly that assertion — see CanonicalTagVocabularyTests. -->
    <ProjectReference Include="..\..\..\src\Infrastructure\Servyx.Infrastructure.Docker\Servyx.Infrastructure.Docker.csproj" />
  </ItemGroup>

</Project>
