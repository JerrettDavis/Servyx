<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="TinyBDD" />
    <PackageReference Include="TinyBDD.Xunit" />

    <!-- PlanExecutorTests proves a previewed plan round-trips through the REAL migrated schema: the id
         PreviewAsync returns must read the same plan and the same ordered actions back out of the database.
         The SQLite in-memory provider is used over an explicitly opened connection (not the EF InMemory
         provider) for the reason SqliteDatabaseFixture states — InMemory enforces no foreign keys, no unique
         indexes and no NOT NULL, so a persistence assertion written against it passes for schemas that could
         never be created. Both packages are already centrally versioned in Directory.Packages.props. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Infrastructure\Servyx.Config\Servyx.Config.csproj" />

    <!-- Test-only. Servyx.Config itself references Servyx.Domain and nothing else — PlanExecutor persists
         through the domain's IChangePlanStore abstraction, never through EF — but the round-trip test needs
         the real EfChangePlanStore and the real migrations to be worth anything. -->
    <ProjectReference Include="..\..\..\src\Infrastructure\Servyx.Infrastructure.Persistence\Servyx.Infrastructure.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
