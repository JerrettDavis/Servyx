# =============================================================================
# Palworld Docker Stack - Environment Configuration
# =============================================================================
# Search this file for "REPLACE_ME" to find every value you must supply
# before `docker compose up -d` will produce a working server.
#
# Any value with a "REPLACE_ME_WITH_*" label MUST be edited.
# Everything else is a sensible default you can leave as-is or tune later.
# =============================================================================


# -----------------------------------------------------------------------------
# Core server identity
# -----------------------------------------------------------------------------
TZ=America/Chicago
# Set to your local TZ, e.g. America/New_York, Europe/London, Asia/Tokyo.
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# TZ affects when scheduled jobs (backups, auto-reboot) run.

PUID=1000
PGID=1000
# User/group the server runs as inside the container. Defaults are fine unless
# you have file permission issues on a custom bind mount.

PORT=8211
PLAYERS=16
MULTITHREADING=false
ENABLE_PERF_THREADING_ARGS=false
WORKER_THREADS_SERVER=

# -----------------------------------------------------------------------------
# Server identity (advertised to players in the server browser)
# -----------------------------------------------------------------------------
SERVER_NAME=Palygondwanaland
SERVER_DESCRIPTION=Holding balls and throwing spheres
SERVER_PASSWORD=REDACTED_SERVER_PASSWORD
# ^ Leave blank to run an open server (no password required to join).
#   Set a value to require a password.

ADMIN_PASSWORD=REDACTED_ADMIN_PASSWORD
# ^ Password used to authenticate as admin via RCON / REST API.
#   PICK A STRONG ONE. Anyone with this can kick/ban/shutdown the server.

PUBLIC_IP=203.0.113.10
# ^ Your server's public IPv4 address. Optional - the server can auto-detect
#   it. Set this only if auto-detection reports the wrong IP (common behind
#   some NAT setups).
PUBLIC_PORT=

REGION=
# Region tag advertised in the server list (e.g. "us-east", "eu-west"). Empty
# is fine; the player list will just not be region-filtered.

CROSSPLAY_PLATFORMS=(Steam,Xbox,PS5,Mac)
# Platforms allowed to connect. Remove platforms you don't want.

# Community server list (shows in the in-game "Community" tab).
# Requires PUBLIC_IP set above AND a SERVER_PASSWORD. Set true to publish.
COMMUNITY=true

USEAUTH=True
# When true, players must sign in with their Palworld account before joining.

# -----------------------------------------------------------------------------
# Ports (must match compose.yaml)
# -----------------------------------------------------------------------------
QUERY_PORT=27015
REST_API_PORT=8212

# -----------------------------------------------------------------------------
# RCON (remote console - required for graceful shutdown, restore-from-backup,
# auto-pause checks, and the `docker exec ... rcon-cli` helper command)
# -----------------------------------------------------------------------------
RCON_ENABLED=true
RCON_PORT=25575

# -----------------------------------------------------------------------------
# REST API (used for player-list polling, auto-pause, and the healthcheck)
# Bind to all interfaces inside the container; only expose via compose ports.
# -----------------------------------------------------------------------------
REST_API_ENABLED=True
ENABLE_GAMEDATA_API=false
SHOW_PLAYER_LIST=False
CHAT_POST_LIMIT_PER_MINUTE=30

# -----------------------------------------------------------------------------
# Discord integration (WEBHOOKS - NOT bot tokens)
# -----------------------------------------------------------------------------
# This image posts server events to Discord via webhooks, which are
# simple HTTPS endpoints tied to a channel. You do NOT need a bot, OAuth,
# or any Discord developer credentials.
#
# To create a webhook:
#   1. In Discord, open your server
#   2. Click the server name -> Settings -> Integrations -> Webhooks
#   3. "New Webhook" -> pick the channel -> "Copy Webhook URL"
#   4. Paste that URL below.
#
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REDACTED/REDACTED_TOKEN

DISCORD_SUPPRESS_NOTIFICATIONS=true
# Adds @silent to outbound messages so the channel doesn't ping @everyone.
# Recommended true for shared servers.

DISCORD_CONNECT_TIMEOUT=30
DISCORD_MAX_TIMEOUT=30

# ---- Lifecycle messages -----------------------------------------------------
DISCORD_PRE_START_MESSAGE_ENABLED=true
DISCORD_PRE_START_MESSAGE=Server is starting...

DISCORD_PRE_SHUTDOWN_MESSAGE_ENABLED=true
DISCORD_PRE_SHUTDOWN_MESSAGE=Server is shutting down...

DISCORD_POST_SHUTDOWN_MESSAGE_ENABLED=true
DISCORD_POST_SHUTDOWN_MESSAGE=Server has stopped.

# ---- Update lifecycle ------------------------------------------------------
DISCORD_PRE_UPDATE_BOOT_MESSAGE_ENABLED=true
DISCORD_PRE_UPDATE_BOOT_MESSAGE=Server is updating...

DISCORD_POST_UPDATE_BOOT_MESSAGE_ENABLED=true
DISCORD_POST_UPDATE_BOOT_MESSAGE=Server update complete!

# ---- Player activity -------------------------------------------------------
DISCORD_PLAYER_JOIN_MESSAGE_ENABLED=true
DISCORD_PLAYER_JOIN_MESSAGE=:inbox_tray: `player_name` joined the server

DISCORD_PLAYER_LEAVE_MESSAGE_ENABLED=true
DISCORD_PLAYER_LEAVE_MESSAGE=:outbox_tray: `player_name` left the server

# ---- Backups ---------------------------------------------------------------
DISCORD_POST_BACKUP_MESSAGE_ENABLED=true
DISCORD_POST_BACKUP_MESSAGE=Backup created at `file_path`

# Disabled by default (these are noisy; only enable for debugging)
DISCORD_PRE_BACKUP_MESSAGE_ENABLED=false
DISCORD_PRE_BACKUP_MESSAGE=Creating backup...

DISCORD_PRE_BACKUP_DELETE_MESSAGE_ENABLED=false
DISCORD_PRE_BACKUP_DELETE_MESSAGE=Removing backups older than `old_backup_days` days

DISCORD_ERR_BACKUP_DELETE_MESSAGE_ENABLED=false
DISCORD_ERR_BACKUP_DELETE_MESSAGE=Unable to delete old backups, OLD_BACKUP_DAYS is not an integer. OLD_BACKUP_DAYS=`old_backup_days`

# Each _URL variable can override the destination channel for that specific
# message. Leave blank to fall back to DISCORD_WEBHOOK_URL.
DISCORD_PRE_START_MESSAGE_URL=
DISCORD_PRE_SHUTDOWN_MESSAGE_URL=
DISCORD_POST_SHUTDOWN_MESSAGE_URL=
DISCORD_PRE_UPDATE_BOOT_MESSAGE_URL=
DISCORD_POST_UPDATE_BOOT_MESSAGE_URL=
DISCORD_PLAYER_JOIN_MESSAGE_URL=
DISCORD_PLAYER_LEAVE_MESSAGE_URL=
DISCORD_PRE_BACKUP_MESSAGE_URL=
DISCORD_POST_BACKUP_MESSAGE_URL=
DISCORD_PRE_BACKUP_DELETE_MESSAGE_URL=
DISCORD_ERR_BACKUP_DELETE_MESSAGE_URL=

# -----------------------------------------------------------------------------
# Backups
# -----------------------------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_CRON_EXPRESSION=0 0 * * *
# Daily at midnight in the TZ set above.
DELETE_OLD_BACKUPS=true
OLD_BACKUP_DAYS=30
# Backups older than 30 days are deleted automatically.

# -----------------------------------------------------------------------------
# Auto-update (game updates can break saves - leave off, update manually)
# -----------------------------------------------------------------------------
AUTO_UPDATE_ENABLED=false
AUTO_UPDATE_CRON_EXPRESSION=0 * * * *
AUTO_UPDATE_WARN_MINUTES=30

# -----------------------------------------------------------------------------
# Auto-reboot (daily fresh boot keeps memory leaks in check)
# -----------------------------------------------------------------------------
AUTO_REBOOT_ENABLED=true
AUTO_REBOOT_CRON_EXPRESSION=0 0 * * *
# Daily at midnight (server TZ).
AUTO_REBOOT_WARN_MINUTES=10
# In-game warning broadcast 10 minutes before reboot.
AUTO_REBOOT_EVEN_IF_PLAYERS_ONLINE=false
# Only reboot when no players are online. Set true to force a daily reboot.

# -----------------------------------------------------------------------------
# Auto-pause (server sleeps when no one is online - saves power on a home host)
# Requires: RCON_ENABLED=true, ENABLE_PLAYER_LOGGING=true, REST_API_ENABLED=true
# -----------------------------------------------------------------------------
AUTO_PAUSE_ENABLED=true
AUTO_PAUSE_TIMEOUT_EST=180
# Pause after ~3 minutes of zero players online.
AUTO_PAUSE_LOG=true
AUTO_PAUSE_DEBUG=false

# -----------------------------------------------------------------------------
# Player logging (required for join/leave Discord pings and auto-pause)
# -----------------------------------------------------------------------------
ENABLE_PLAYER_LOGGING=true
PLAYER_LOGGING_POLL_PERIOD=5
LOG_FILTER_ENABLED=true
LOG_FORMAT_TYPE=default

# -----------------------------------------------------------------------------
# Update behaviour
# -----------------------------------------------------------------------------
UPDATE_ON_BOOT=true
# Check for image updates when the container starts.
# Set false to fully control when updates happen (manual `docker compose pull`).

# -----------------------------------------------------------------------------
# Game-balance tunables (defaults from the image - tune to taste)
# -----------------------------------------------------------------------------
DIFFICULTY=None
RANDOMIZER_TYPE=
RANDOMIZER_SEED=none
DAYTIME_SPEEDRATE=1.000000
NIGHTTIME_SPEEDRATE=1.000000
EXP_RATE=1.000000
PAL_CAPTURE_RATE=1.000000
PAL_SPAWN_NUM_RATE=1.000000
PAL_DAMAGE_RATE_ATTACK=1.000000
PAL_DAMAGE_RATE_DEFENSE=1.000000
PLAYER_DAMAGE_RATE_ATTACK=1.000000
PLAYER_DAMAGE_RATE_DEFENSE=1.000000
PLAYER_STOMACH_DECREASE_RATE=1.000000
PLAYER_STAMINA_DECREASE_RATE=1.000000
PLAYER_AUTO_HP_REGEN_RATE=1.000000
PLAYER_AUTO_HP_REGEN_RATE_IN_SLEEP=1.000000
PAL_STOMACH_DECREASE_RATE=1.000000
PAL_STAMINA_DECREASE_RATE=1.000000
PAL_AUTO_HP_REGEN_RATE=1.000000
PAL_AUTO_HP_REGEN_RATE_IN_SLEEP=1.000000
BUILD_OBJECT_HP_RATE=1.000000
BUILD_OBJECT_DAMAGE_RATE=1.000000
BUILD_OBJECT_DETERIORATION_DAMAGE_RATE=1.000000
COLLECTION_DROP_RATE=1.000000
COLLECTION_OBJECT_HP_RATE=1.000000
COLLECTION_OBJECT_RESPAWN_SPEED_RATE=1.000000
ENEMY_DROP_ITEM_RATE=1.000000
DEATH_PENALTY=None
ENABLE_PLAYER_TO_PLAYER_DAMAGE=False
ENABLE_FRIENDLY_FIRE=False
ENABLE_INVADER_ENEMY=True
ACTIVE_UNKO=False
ENABLE_AIM_ASSIST_PAD=True
ENABLE_AIM_ASSIST_KEYBOARD=False
DROP_ITEM_MAX_NUM=3000
DROP_ITEM_MAX_NUM_UNKO=100
BASE_CAMP_MAX_NUM=128
BASE_CAMP_WORKER_MAX_NUM=50
DROP_ITEM_ALIVE_MAX_HOURS=1.000000
AUTO_RESET_GUILD_NO_ONLINE_PLAYERS=False
AUTO_RESET_GUILD_TIME_NO_ONLINE_PLAYERS=72.00000
GUILD_PLAYER_MAX_NUM=20
BASE_CAMP_MAX_NUM_IN_GUILD=5
PAL_EGG_DEFAULT_HATCHING_TIME=0.000000
WORK_SPEED_RATE=1.000000
AUTO_SAVE_SPAN=30.000000
IS_MULTIPLAY=False
IS_PVP=False
HARDCORE=False
CHARACTER_RECREATE_IN_HARDCORE=False
PAL_LOST=False
CAN_PICKUP_OTHER_GUILD_DEATH_PENALTY_DROP=False
ENABLE_NON_LOGIN_PENALTY=True
ENABLE_FAST_TRAVEL=True
IS_START_LOCATION_SELECT_BY_MAP=False
EXIST_PLAYER_AFTER_LOGOUT=False
ENABLE_DEFENSE_OTHER_GUILD_PLAYER=False
INVISIBLE_OTHER_GUILD_BASE_CAMP_AREA_FX=False
BUILD_AREA_LIMIT=False
ITEM_WEIGHT_RATE=1.000000
COOP_PLAYER_MAX_NUM=4
BAN_LIST_URL=https://b.palworldgame.com/api/banlist.txt
MAX_BUILDING_LIMIT_NUM=0
SERVER_REPLICATE_PAWN_CULL_DISTANCE=15000.000000
SERVER_REPLICATE_PAWN_CULL_DISTANCE_IN_BASE_CAMP=5000.000000
USE_BACKUP_SAVE_DATA=True
USE_DEPOT_DOWNLOADER=False
INSTALL_BETA_INSIDER=False
ALLOW_GLOBAL_PALBOX_EXPORT=True
ALLOW_GLOBAL_PALBOX_IMPORT=True
EQUIPMENT_DURABILITY_DAMAGE_RATE=1.000000
ITEM_CONTAINER_FORCE_MARK_DIRTY_INTERVAL=1.000000
ITEM_CORRUPTION_MULTIPLIER=1.000000
PHYSICS_ACTIVE_DROP_ITEM_MAX_NUM=-1
ALLOW_CLIENT_MOD=True
PLAYER_DATA_PAL_STORAGE_UPDATE_CHECK_TICK_INTERVAL=1.000000
IS_SHOW_JOIN_LEFT_MESSAGE=True
MONSTER_FARM_ACTION_SPEED_RATE=1.000000
DENY_TECHNOLOGY_LIST=
GUILD_REJOIN_COOLDOWN_MINUTES=0
AUTO_TRANSFER_MASTER_CHECK_INTERVAL_SECONDS=3600.000000
AUTO_TRANSFER_MASTER_THRESHOLD_DAYS=14
MAX_GUILDS_PER_FRAME=10
BLOCK_RESPAWN_TIME=5.000000
RESPAWN_PENALTY_DURATION_THRESHOLD=0.000000
RESPAWN_PENALTY_TIME_SCALE=2.000000
DISPLAY_PVP_ITEM_NUM_ON_WORLD_MAP_BASE_CAMP=False
DISPLAY_PVP_ITEM_NUM_ON_WORLD_MAP_PLAYER=False
ADDITIONAL_DROP_ITEM_WHEN_PLAYER_KILLING_IN_PVP_MODE=PlayerDropItem
ADDITIONAL_DROP_ITEM_NUM_WHEN_PLAYER_KILLING_IN_PVP_MODE=1
ADDITIONAL_DROP_ITEM_WHEN_PLAYER_KILLING_IN_PVP_MODE_ENABLED=False
ENABLE_VOICE_CHAT=False
VOICE_CHAT_MAX_VOLUME_DISTANCE=3000.000000
VOICE_CHAT_ZERO_VOLUME_DISTANCE=15000.000000
ALLOW_ENHANCE_STAT_HEALTH=True
ALLOW_ENHANCE_STAT_ATTACK=True
ALLOW_ENHANCE_STAT_STAMINA=True
ALLOW_ENHANCE_STAT_WEIGHT=True
ALLOW_ENHANCE_STAT_WORK_SPEED=True
ENABLE_BUILDING_PLAYER_UID_DISPLAY=False
BUILDING_NAME_DISPLAY_CACHE_TTL_SECONDS=60

# -----------------------------------------------------------------------------
# Box64 tuning (only relevant on ARM64 hosts - harmless on x86_64)
# -----------------------------------------------------------------------------
BOX64_DYNAREC_STRONGMEM=1
BOX64_DYNAREC_BIGBLOCK=1
BOX64_DYNAREC_SAFEFLAGS=1
BOX64_DYNAREC_FASTROUND=1
BOX64_DYNAREC_FASTNAN=1
BOX64_DYNAREC_X87DOUBLE=0